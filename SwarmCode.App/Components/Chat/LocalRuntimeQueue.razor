@namespace SwarmCode.App.Components.Chat
@using SwarmCore.Abstractions.LlmRouting
@implements IDisposable

@if (Current.Items.Count > 0 || _error is not null)
{
    <details class="sess-runtime-queue" open="@(Waiting is not null)" data-testid="local-runtime-queue">
        <summary><strong>@Headline</strong><span class="sess-muted">@Current.Items.Count(x => x.Phase != LocalLlmRuntimeQueuePhase.UsingModel) waiting</span></summary>
        <div class="sess-runtime-queue__body">
            @if (Waiting is { } waiting)
            {
                <p>Your prompt has waited @Duration(Now - waiting.QueuedUtc). It has not been sent to the model for this attempt.</p>
                @if (!Current.Items.Any(x => x.Phase == LocalLlmRuntimeQueuePhase.UsingModel))
                {
                    <p>Another request holds the local AI slot but has not shared its current task. Its app, model and queue details are unavailable.</p>
                }
                @if (waiting.AdmissionDeadlineUtc is { } deadline)
                {
                    <p class="sess-muted">Code will stop waiting in @Duration(deadline - Now) and keep your conversation.</p>
                }
                <div class="sess-runtime-queue__actions">
                    <button type="button" class="sess-btn" @onclick="OnStop">Stop waiting</button>
                    <button type="button" class="sess-btn" @onclick="OnChooseModel">Model choices</button>
                </div>
                <p class="sess-muted">You can keep waiting, or stop and choose another provider before sending again. Model choices apply to the next message.</p>
            }
            @if (Own is { Phase: LocalLlmRuntimeQueuePhase.UsingModel })
            {
                <p>Your model has the slot. It may be loading, reading the prompt, or generating an answer. Elapsed time is not a progress estimate.</p>
            }
            <ul aria-label="Local AI requests">
                @foreach (var item in Current.Items)
                {
                    <li @key="item.Id">
                        <div><strong>@(IsOwn(item) ? "This chat" : item.Application)</strong><span>@State(item.Phase) · @Duration(Now - item.PhaseStartedUtc)</span></div>
                        <div class="sess-muted">@item.Provider / @item.Model</div>
                        <div class="sess-muted">@Work(item) · @(item.Interactivity == LlmInteractivity.UserWaiting ? "Someone is waiting" : "Background work")</div>
                    </li>
                }
            </ul>
            @if (Current.IsPartial || _error is not null)
            {
                <p class="sess-muted">Some activity could not be read. Older apps may not share their queue. This list is not a complete device inventory.</p>
            }
            <p class="sess-muted">Local AI is shared by apps on this device. Code asks background work to yield the next slot; older apps may not support this. Requests are listed by priority and arrival, not a guaranteed turn order. A finish time is not available.</p>
            <details><summary>What to do if work stays blocked</summary><p>Check the app using the model and pause or stop its work there. If the model server is stuck, restart it in its own app; this interrupts other local AI requests. Code does not stop another app’s work from this panel.</p></details>
        </div>
    </details>
}

@code {
    [Parameter] public LocalLlmRuntimeQueueSnapshot? Snapshot { get; set; }
    [Parameter] public Func<CancellationToken, Task<LocalLlmRuntimeQueueSnapshot>>? ReadQueue { get; set; }
    [Parameter] public string OwnerId { get; set; } = "";
    [Parameter] public bool IsRunning { get; set; }
    [Parameter] public EventCallback OnStop { get; set; }
    [Parameter] public EventCallback OnChooseModel { get; set; }
    [Parameter] public EventCallback<string?> OnStatusChanged { get; set; }
    [Parameter] public DateTimeOffset? UtcNow { get; set; }
    private LocalLlmRuntimeQueueSnapshot? _live;
    private string? _error;
    private string? _lastStatus;
    private int _disposed;
    private readonly CancellationTokenSource _lifetime = new();
    private LocalLlmRuntimeQueueSnapshot Current => _live ?? Snapshot ?? new([], true);
    private DateTimeOffset Now => UtcNow ?? DateTimeOffset.UtcNow;
    private bool IsOwn(LocalLlmRuntimeQueueItem row) => row.ProcessId == Environment.ProcessId && row.OwnerId == OwnerId;
    private LocalLlmRuntimeQueueItem? Own => IsRunning ? Current.Items.FirstOrDefault(IsOwn) : null;
    private LocalLlmRuntimeQueueItem? Waiting => Own is { Phase: not LocalLlmRuntimeQueuePhase.UsingModel } row ? row : null;
    private string Headline => Waiting is { } row
        ? row.Phase == LocalLlmRuntimeQueuePhase.WaitingInApp ? "Waiting for local AI in this app" : "Waiting for local AI on this device"
        : Own is not null ? "Using local model" : "Local AI activity";

    protected override void OnInitialized() => _ = Task.Run(PollAsync);
    private async Task PollAsync()
    {
        try
        {
            while (!_lifetime.IsCancellationRequested)
            {
                var read = ReadQueue;
                var owner = OwnerId;
                if (read is not null)
                {
                    LocalLlmRuntimeQueueSnapshot snapshot;
                    try { snapshot = await read(_lifetime.Token).ConfigureAwait(false); }
                    catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { break; }
                    catch (Exception) { snapshot = new([], true); }
                    await InvokeAsync(async () =>
                    {
                        if (_lifetime.IsCancellationRequested || owner != OwnerId) return;
                        _live = snapshot;
                        _error = snapshot.IsPartial && snapshot.Items.Count == 0 ? "unavailable" : null;
                        var status = Own is null ? null : Headline;
                        if (_lastStatus != status) { _lastStatus = status; await OnStatusChanged.InvokeAsync(status); }
                        StateHasChanged();
                    });
                }
                await Task.Delay(TimeSpan.FromSeconds(1), _lifetime.Token).ConfigureAwait(false);
            }
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (ObjectDisposedException) { }
        finally { _lifetime.Dispose(); }
    }
    private static string Duration(TimeSpan value) => value.TotalMinutes >= 1 ? $"{Math.Max(0, (int)value.TotalMinutes)}m {Math.Max(0, value.Seconds)}s" : $"{Math.Max(0, (int)value.TotalSeconds)}s";
    private static string State(LocalLlmRuntimeQueuePhase phase) => phase switch
    { LocalLlmRuntimeQueuePhase.UsingModel => "Using model", LocalLlmRuntimeQueuePhase.WaitingInApp => "Waiting in app", _ => "Waiting for device" };
    private static string Work(LocalLlmRuntimeQueueItem row) => row.Kind == LocalLlmWorkloadKind.Embedding ? "Search indexing"
        : row.Kind == LocalLlmWorkloadKind.Vision ? "Image processing" : row.Workload switch
        { LlmWorkloadKind.Maintenance => "Maintenance", LlmWorkloadKind.DeferredEnrichment => "Data processing", _ => "Model request" };
    public void Dispose() { if (Interlocked.Exchange(ref _disposed, 1) == 0) _lifetime.Cancel(); }
}

{
  "schemaVersion": 1,
  "packId": "talavine.codex-cli",
  "version": "2026.10.11.2",
  "providerName": "CodexCli",
  "modelPrefix": "codex-cli",
  "executionDialect": "codex-cli-exec-v1",
  "modelDefaults": { "frontier": "codex-cli:gpt-6-astra", "balanced": "codex-cli:gpt-5.6-terra", "economy": "codex-cli:gpt-5.6-luna" },
  "subscriptionCli": {
    "automaticRoutingEnabled": true,
    "discoveryPriority": 20,
    "catalogRefreshDays": 7,
    "command": "codex",
    "npmPackage": "@openai/codex",
    "environmentVariables": [
      "SWARMCORE_CODEX_CLI",
      "TALAVINE_CODEX_CLI",
      "CODEX_CLI"
    ],
    "loginArguments": ["login"],
    "loginStatusArguments": ["login", "status"],
    "controlledLaunch": {
      "homeEnvironmentVariable": "CODEX_HOME",
      "configurationRoots": ["config.toml", "requirements.toml", "profiles", "plugins", "rules", "skills", "hooks.json", "AGENTS.md", "AGENTS.override.md"],
      "fileAuthenticationArguments": ["-c", "cli_auth_credentials_store=\"file\"", "-c", "forced_login_method=\"chatgpt\""],
      "authenticatedMode": "ChatGPT",
      "nonSecretConfigurationTemplates": {
        "config.toml": "cli_auth_credentials_store = \"file\"\nforced_login_method = \"chatgpt\"\n"
      }
    },
    "authenticatedStatusMarkers": ["Logged in using ChatGPT"],
    "recognizedStatusMarkers": ["Logged in using", "not logged in"],
    "defaultModel": "codex-cli:gpt-5.6-terra",
    "builtInModels": [
      "codex-cli:gpt-5.6-luna",
      "codex-cli:gpt-5.6-terra",
      "codex-cli:gpt-5.6-sol",
      "codex-cli:gpt-6-astra",
      "codex-cli:default"
    ],
    "relativeCapacityWeights": {
      "codex-cli:gpt-5.6-luna": 1,
      "codex-cli:gpt-5.6-terra": 10,
      "codex-cli:gpt-5.6-sol": 20,
      "codex-cli:gpt-6-astra": 50,
      "codex-cli:default": 10
    },
    "reasoningEfforts": ["minimal", "low", "medium", "high", "xhigh"],
    "discoveryReasoningEfforts": ["low", "medium", "high"],
    "helpArguments": ["--help"],
    "modelConfigPaths": [".codex/config.toml"],
    "inferenceArguments": [
      "-c",
      "approval_policy='never'",
      "--disable",
      "apps",
      "--disable",
      "browser_annotation_api",
      "--disable",
      "browser_use",
      "--disable",
      "browser_use_external",
      "--disable",
      "browser_use_full_cdp_access",
      "--disable",
      "computer_use",
      "--disable",
      "hooks",
      "--disable",
      "code_mode",
      "--disable",
      "code_mode_host",
      "--disable",
      "code_mode_only",
      "--disable",
      "shell_tool",
      "--disable",
      "unified_exec",
      "--disable",
      "shell_snapshot",
      "--disable",
      "tool_call_mcp_elicitation",
      "--disable",
      "mcp_2026_07_28",
      "--disable",
      "plugins",
      "--disable",
      "remote_plugin",
      "--disable",
      "plugin_sharing",
      "--disable",
      "multi_agent",
      "--disable",
      "multi_agent_v2",
      "--disable",
      "multi_agent_v2_dynamic_tools",
      "--disable",
      "standalone_web_search",
      "--disable",
      "view_image",
      "--disable",
      "image_generation",
      "--disable",
      "workspace_dependencies",
      "--disable",
      "skill_mcp_dependency_install",
      "--disable",
      "skill_search",
      "--disable",
      "tool_suggest",
      "--disable",
      "in_app_browser",
      "--disable",
      "in_app_local_automation",
      "--disable",
      "in_app_chat",
      "--disable",
      "in_app_voice",
      "--disable",
      "in_app_dictation",
      "--disable",
      "in_app_updates",
      "--disable",
      "auth_elicitation",
      "--disable",
      "request_permissions_tool",
      "--disable",
      "realtime_conversation",
      "exec",
      "--ignore-user-config",
      "--ignore-rules",
      "--cd",
      "{workingDirectory}",
      "--skip-git-repo-check",
      "--ephemeral",
      "--sandbox",
      "read-only",
      "--output-last-message",
      "{outputPath}"
    ],
    "modelArgument": "--model",
    "reasoningConfigFormat": "model_reasoning_effort='{0}'",
    "foundationProviders": ["OpenAI"],
    "capabilityAliases": {
      "default": ["codex", "gpt-5"]
    }
  }
}

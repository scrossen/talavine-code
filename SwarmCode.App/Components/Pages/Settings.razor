    private void LoadDefaultModel()
    {
        var prefs = Prefs;
        _defaultLaneBaseline = prefs.DefaultLane; _defaultModelBaseline = prefs.DefaultModel;
        _defaultModelLane = prefs.DefaultLane ?? "";
        _defaultModel = Prefs.DefaultModel ?? AvailableLanes().FirstOrDefault(l => l.Name.Equals(_defaultModelLane, StringComparison.OrdinalIgnoreCase))?.Model ?? "";
        _defaultModels = []; _defaultModelDetails = [];
    }

    private async Task DefaultModelLaneChangedAsync(ChangeEventArgs e)
    {
        _defaultModelLane = e.Value?.ToString() ?? "";
        var selected = AvailableLanes().FirstOrDefault(l => l.Name.Equals(_defaultModelLane, StringComparison.OrdinalIgnoreCase));
        _defaultModel = selected?.Model ?? "";
        _defaultModels = []; _defaultModelDetails = [];
        var generation = ++_defaultModelGeneration;
        _defaultModelStatus = null;
        _defaultModelsLoading = false;
        if (selected is null || State.Workspace is not { } workspace) return;
        _defaultModelsLoading = true;
        try
        {
            var models = await Task.Run(async () =>
            {
                using var scope = workspace.Services.CreateScope();
                return await scope.ServiceProvider.GetRequiredService<CodingModelCatalog>().GetCatalogAsync(selected);
            });
            if (generation == _defaultModelGeneration) { _defaultModels = models.Models; _defaultModelDetails = models.Details; _defaultModelStatus = models.Source; }
        }
        catch (Exception ex) { if (generation == _defaultModelGeneration) _defaultModelStatus = ex is OperationCanceledException ? "Model lookup timed out. Refresh to retry or enter a custom model ID." : ex.Message; }
        finally { if (generation == _defaultModelGeneration) _defaultModelsLoading = false; }
    }

    private async Task RefreshDefaultModelsAsync()
    {
        var model = _defaultModel;
        var pending = DefaultModelLaneChangedAsync(new ChangeEventArgs { Value = _defaultModelLane });
        _defaultModel = model;
        await pending;
    }

    private async Task UseCurrentDefaultsAsync()
    {
        if (_returnSessionId is null) return;
        var session = await State.Sessions.GetAsync(_returnSessionId);
        var lane = session?.Selection?.Route ?? session?.LaneName;
        var model = session?.Selection?.Model ?? (lane is null ? null : session?.ModelChoices.GetValueOrDefault(lane));
        model ??= AvailableLanes().FirstOrDefault(l => l.Name == lane)?.Model;
        if (lane is null || string.IsNullOrWhiteSpace(model)) { Show("Select a provider and model in the session first.", true); return; }
        _defaultModelLane = lane; _defaultModel = model;
        await SaveDefaultModelAsync();
    }

    private async Task SaveDefaultModelAsync()
    {
        try
        {
            if (!string.IsNullOrEmpty(_defaultModelLane))
            {
                if (!AvailableLanes().Any(l => l.Name.Equals(_defaultModelLane, StringComparison.OrdinalIgnoreCase)))
                { Show("Choose an available model route.", true); return; }
                if (string.IsNullOrWhiteSpace(_defaultModel)) { Show("Choose a model first.", true); return; }
            }
            var lane = string.IsNullOrEmpty(_defaultModelLane) ? null : _defaultModelLane;
            var model = lane is null ? null : _defaultModel.Trim();
            var baselineLane = _defaultLaneBaseline; var baselineModel = _defaultModelBaseline;
            await Task.Run(() => State.Preferences.Update(p =>
            {
                if ((p.DefaultLane != baselineLane || p.DefaultModel != baselineModel) && (p.DefaultLane != lane || p.DefaultModel != model))
                    throw new InvalidOperationException("Defaults changed. Reload defaults before saving; your draft has been preserved.");
                p.DefaultLane = lane; p.DefaultModel = model;
            }));
            _defaultLaneBaseline = lane; _defaultModelBaseline = model;
            Show("Default model saved for new sessions.", false);
        }
        catch (Exception ex) { Show($"Could not save the default model: {ex.Message}", true); }
    }


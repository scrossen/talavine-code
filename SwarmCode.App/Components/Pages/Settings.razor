@page "/settings"
@implements IDisposable
@inject AppState State
@inject IJSRuntime JS
@using SwarmCore.Coding.Routing
@using SwarmCore.Secrets
@using SwarmCore.Coding
@using SwarmCore.Coding.Computer
@using SwarmCore.Coding.Files
@using SwarmCode.Hosting.Web
@using SwarmCode.Hosting.Goals

<PageTitle>Settings - Talavine Code</PageTitle>

<div class="sc-page">
    <header class="sc-topbar">
        <div>
            <h1 class="sc-topbar__title">Settings</h1>
            <p class="sc-topbar__copy">Make it yours. Open a category, or ask the agent to change a setting.</p>
        </div>
        <div class="sc-topbar__actions">
            <a class="sc-btn sc-btn--primary" href="@(_returnSessionId is null ? "/" : AppNavigation.SessionUrl(_returnSessionId))">
                @(_returnSessionId is null ? "Back to home" : "Back to session")
            </a>
        </div>
    </header>

    @if (_message is not null)
    {
        <div class="sc-notice @(_messageIsError ? "sc-notice--error" : "sc-notice--info")" role="status">@_message</div>
    }

    <div class="sc-settings-intro">
        <span class="sc-chip">You can just ask</span>
        <p>“Make my current selections the default model, provider and reasoning.”</p>
        <span class="sc-muted">The agent can read and change settings for you.</span>
    </div>
    <label class="sc-field__label" for="sc-settings-search">Find a setting</label>
    <input id="sc-settings-search" class="sc-input sc-settings-search" type="search" placeholder="Search models, permissions, Chrome…" @bind="_settingsSearch" @bind:event="oninput" />
    <div class="sc-settings-grid">
    <SettingsDialog Id="models" Title="Models and defaults" Description="Starting provider, model and reasoning." Filter="@_settingsSearch" Message="@_message" IsError="@_messageIsError" Summary="@(Prefs.DefaultModel ?? "Use configured defaults")">
    <section class="sc-card">
        <h2 class="sc-card__title">Models</h2>
        <div class="sc-row">
            <div class="sc-field">
                <span class="sc-field__label">Default provider for new sessions</span>
                <ProviderPicker Label="Default provider for new sessions" Value="@_defaultModelLane"
                                ValueChanged="name => DefaultModelLaneChangedAsync(new ChangeEventArgs { Value = name })"
                                Lanes="AvailableLanes().ToArray()" IncludeAutomatic="true" AutomaticLabel="Use the configured default" />
            </div>
            @if (!string.IsNullOrEmpty(_defaultModelLane))
            {
                <div class="sc-field">
                    <label class="sc-field__label" for="sc-default-model">Model</label>
                    <input id="sc-default-model" class="sc-input sc-input--mono" list="sc-default-models" @bind="_defaultModel" />
                    <button type="button" class="sc-btn sc-btn--sm" disabled="@_defaultModelsLoading" @onclick="RefreshDefaultModelsAsync">Refresh models</button>
                    <span class="sc-muted" role="status">@(_defaultModelsLoading ? "Loading models…" : _defaultModelStatus)</span>
                    <datalist id="sc-default-models">@foreach (var model in _defaultModels) { <option value="@model"></option> }</datalist>
                </div>
            }
            <ReasoningPicker @bind-Model="_defaultModel" Lane="@AvailableLanes().FirstOrDefault(l => l.Name == _defaultModelLane)" Workspace="@State.Workspace" Models="_defaultModelDetails" />
            <button type="button" class="sc-btn sc-btn--primary" @onclick="SaveDefaultModelAsync">Save defaults</button>
            <button type="button" class="sc-btn" @onclick="LoadDefaultModel">Reload defaults</button>
            @if (_returnSessionId is not null)
            {
                <button type="button" class="sc-btn" @onclick="UseCurrentDefaultsAsync">Use current session selections</button>
            }
        </div>
        <p class="sc-muted">New sessions start with this model. Existing sessions keep their selection. @if (!AvailableLanes().Any()) { <span>Open a repository to detect installed models, or add a model route below.</span> }</p>
        <div class="sc-settings-model-favorites">
            <ChatModelFavorites Current="DefaultModelFavorite" Favorites="_defaultFavorites" OnChange="ChangeDefaultFavoriteAsync"
                                OnSelect="ChooseDefaultFavoriteAsync" IsAvailable="DefaultFavoriteAvailable" Disabled="_defaultModelsLoading" Error="@_defaultFavoritesError" />
            <p class="sc-muted">Pins save immediately and also appear in the chat model popup. Choose a pinned model here, then use Save defaults to make it the starting model for new sessions.</p>
            @if (DefaultModelFavorite is null) { <p class="sc-muted">Choose a provider and model above to pin it.</p> }
        </div>
    </section>
<DecisionSelectionSettingsPanel />
    </SettingsDialog>
    <SettingsDialog Id="providers" Title="Providers and API keys" Description="Connect a cloud provider or model server." Filter="@_settingsSearch" Message="@_message" IsError="@_messageIsError">
<ModelSourcesPanel OnSaved="SourcesChangedAsync" />

    <section class="sc-card">
        <h2 class="sc-card__title">Cloud API keys</h2>
        <p class="sc-card__copy">Paste an API key for each cloud provider you want to use. Keys are stored in the protected vault on this computer and never shown again.</p>
        <div class="sc-list">
            @foreach (var provider in ByokProviders)
            {
                var name = provider;
                <div class="sc-list__row">
                    <span class="sc-list__label"><strong>@name</strong></span>
                    @if (_keyStatus.TryGetValue(name, out var has) && has)
                    {
                        <span class="sc-chip sc-chip--ok">Key set</span>
                    }
                    else
                    {
                        <span class="sc-chip sc-chip--warn">Missing</span>
                    }
                    <input type="password" class="sc-input" autocomplete="off" placeholder="Paste API key"
                           value="@KeyInput(name)" @oninput="e => _keyInputs[name] = e.Value?.ToString() ?? string.Empty" />
                    <button type="button" class="sc-btn sc-btn--sm" @onclick="() => SaveKeyAsync(name)">Save</button>
                    @if (_keyStatus.TryGetValue(name, out var set) && set)
                    {
                        <button type="button" class="sc-btn sc-btn--sm sc-btn--danger" title="Remove key" @onclick="() => ClearKeyAsync(name)">✕</button>
                    }
                </div>
            }
        </div>
        <p class="sc-muted">
            Subscription tools (Claude Code, Codex, Gemini CLI) sign in through their own command line and need no key here.
            @if (State.Workspace is not null)
            {
                var cli = State.Workspace.Lanes.Where(l => l.IsNative || l.Provider is "ClaudeCode" or "CodexCli").ToList();
                @if (cli.Count > 0)
                {
                    <span>Detected: </span>
                    @foreach (var l in cli)
                    {
                        var off = NativeOff && l.IsNative;
                        <span class="sc-chip @(off ? "sc-chip--off" : "sc-chip--ok")" title="@(off ? NativeApprovalNote : null)">@l.Name</span> <text> </text>
                    }
                }
                else
                {
                    <span>None detected on this computer.</span>
                }
            }
        </p>
    </section>
    </SettingsDialog>
    <SettingsDialog Id="behavior" Title="Appearance and permissions" Description="Text size, reasoning display, editor and approvals." Filter="@_settingsSearch" Message="@_message" IsError="@_messageIsError">
    <section class="sc-card">
        <h2 class="sc-card__title">Behavior</h2>
        <p class="sc-card__copy">Control how cautious the agent is and how the chat looks.</p>
        <div class="sc-list">
            <div class="sc-list__row">
                <div class="sc-field">
                    <label class="sc-field__label" for="sc-permission-mode">Permission mode</label>
                    <select id="sc-permission-mode" class="sc-select" value="@CodingPermissionPolicy.Name(Prefs.Mode)" @onchange="e => SetMode(e.Value)">
                        <option value="auto">Auto: everything runs</option>
                        <option value="ask-risky">Ask before risky actions</option>
                        <option value="ask">Ask before every action</option>
                    </select>
                </div>
                <p class="sc-muted sc-note">@ModeNote(Prefs.Mode) Agents a session starts use at least that session's mode.@(NativeOff ? " " + NativeApprovalNote : "")</p>
                <div class="sc-muted sc-note">
                    <span>Always allow: </span>@RuleList(_permissionRules.Allow)
                    <span> · Never allow: </span>@RuleList(_permissionRules.Deny)
                    <div>Edit <code>Coding:Permissions:Allow</code> / <code>Deny</code> (tool-id globs such as <code>git.commit</code> or <code>shell.*</code>) in <code>@SettingsFile.Path</code>. Deny always wins; allowed tools skip the prompt.</div>
                </div>
                @if (_repositoryRules is { Exists: true } repoRules)
                {
                    <div class="sc-muted sc-note">
                        <span>Repository deny (always applied): </span>@RuleList(repoRules.Deny)
                        <span> · Repository allow: </span>@RuleList(repoRules.Allow)
                        @if (repoRules.Allow.Count > 0)
                        {
                            <span class="sc-chip @(repoRules.Approved ? "sc-chip--ok" : "sc-chip--warn")">@(repoRules.Approved ? "allowed" : "not allowed")</span>
                            @if (repoRules.NeedsApproval)
                            {
                                <button type="button" class="sc-btn sc-btn--sm" disabled="@_busy" @onclick="() => DecideRepositoryRulesAsync(repoRules, allow: true)">Allow</button>
                            }
                            else if (repoRules.Approved)
                            {
                                <button type="button" class="sc-btn sc-btn--sm" disabled="@_busy" @onclick="() => DecideRepositoryRulesAsync(repoRules, allow: false)">Revoke</button>
                            }
                        }
                        <div>From <code>.swarmcode/settings.json</code> or <code>.claude/settings.json</code> in the open repository (<code>permissions.allow</code> / <code>deny</code>). Deny rules always apply; allow rules apply only after you allow that exact content, and any change asks again.</div>
                        @foreach (var problem in repoRules.Problems) { <div>@problem</div> }
                        @if (_repositoryRulesError is not null) { <div>@_repositoryRulesError</div> }
                    </div>
                }
            </div>
            <div class="sc-list__row">
                <label class="sc-field"><span class="sc-field__label">Theme</span>
                    <select class="sc-select" aria-label="Theme" value="@Prefs.Theme" @onchange="SetTheme">
                        <option value="system">System</option><option value="light">Light</option><option value="dark">Dark</option>
                    </select>
                </label>
            </div>
            <div class="sc-list__row">
                <label class="sc-toggle">
                    <input type="checkbox" checked="@Prefs.ShowReasoning" @onchange="e => UpdatePref(p => p.ShowReasoning = (bool)e.Value!)" />
                    <span class="sc-toggle__track"></span>
                    <span>Show the model's reasoning when available</span>
                </label>
            </div>
            <div class="sc-list__row">
                <label class="sc-field__label" for="sc-zoom">Text size (@Prefs.Zoom.ToString("0.00")x)</label>
                <input id="sc-zoom" type="range" class="sc-range" min="0.8" max="1.4" step="0.05" value="@Prefs.Zoom.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                       @onchange="e => UpdatePref(p => p.Zoom = ParseZoom(e.Value))" />
            </div>
            <div class="sc-list__row">
                <label class="sc-field__label" for="sc-editor-command">Editor command (optional)</label>
                <input id="sc-editor-command" class="sc-input sc-input--mono" placeholder="VS Code" value="@Prefs.EditorCommand"
                       @onchange="e => UpdatePref(p => p.EditorCommand = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value!.ToString()!.Trim())" />
                <p class="sc-muted sc-note">Used by "Open in editor". Empty uses VS Code. A command such as <code>cursor</code> gets <code>--goto file:line:col</code>; use <code>{file}</code>, <code>{line}</code> and <code>{column}</code> for other editors.</p>
            </div>
        </div>
    </section>
    </SettingsDialog>
    <SettingsDialog Id="memory" Title="Memory" Description="What the agent remembers and how it learns." Filter="@_settingsSearch" Message="@_message" IsError="@_messageIsError" Summary="@(Prefs.PersonalMemoryEnabled && State.MemoryOptions.Enabled ? "On" : "Off")">
    <MemorySettings Embedded="true" />
    </SettingsDialog>
    <SettingsDialog Id="credentials" Title="Credentials" Description="Save or import passwords, tokens and keys." Filter="@_settingsSearch" Message="@_message" IsError="@_messageIsError" Summary="@($"{_secrets.Count} saved")">
    <section class="sc-card">
        <h2 class="sc-card__title">Credentials</h2>
        <p class="sc-card__copy">
            Passwords, tokens, and keys the agent may use without ever seeing them. Each value is encrypted with a key held by
            @(KeyStoreLabel) and stored in <span class="sc-mono">secrets.db</span>. In chat, the agent writes
            <span class="sc-mono">{{secret:name}}</span> where a value belongs and it is filled in when the command runs.
            You can also type <span class="sc-mono">/secret name value</span> in any session.
        </p>
        @if (!State.KeyStore.IsAvailable)
        {
            <div class="sc-notice sc-notice--error" role="alert">@(OperatingSystem.IsMacOS() || OperatingSystem.IsMacCatalyst()
                ? "Encrypted credential storage is unavailable. New credentials cannot be stored until the OS keystore is available."
                : "No OS keystore is available on this computer, so new values are stored with a plaintext marker. File permissions on the data folder are the only protection.")</div>
        }

        @if (_secrets.Count == 0)
        {
            <p class="sc-muted">Nothing stored yet.</p>
        }
        else
        {
            <div class="sc-row">
                <span class="sc-muted">@_secrets.Count saved credentials</span>
                <button type="button" class="sc-btn" @onclick="OpenCredentialsAsync">View saved credentials</button>
            </div>
        }

        <dialog id="sc-credentials-dialog" class="sc-dialog" aria-labelledby="sc-credentials-title" @ref="_credentialsDialog" @onclose="ClearCredentialSearch">
            <div class="sc-row sc-row--between">
                <h2 id="sc-credentials-title" class="sc-card__title">Saved credentials</h2>
                <button type="button" class="sc-btn" @onclick="CloseCredentialsAsync">Close</button>
            </div>
            <p class="sc-muted">Names and account hints only. Passwords and tokens stay protected.</p>
            <label class="sc-field__label" for="sc-credential-search">Search credentials</label>
            <input id="sc-credential-search" class="sc-input" type="search" @bind="_credentialSearch" @bind:event="oninput" />
            <p class="sc-muted">@FilteredSecrets().Count() of @_secrets.Count credentials</p>
            <div class="sc-dialog__list">
            <table class="sc-table">
                <thead><tr><th>Name</th><th>Kind</th><th>Site</th><th>User</th><th>Last used</th><th></th></tr></thead>
                <tbody>
                    @foreach (var s in FilteredSecrets())
                    {
                        var entry = s;
                        <tr>
                            <td><span class="sc-mono">@entry.Name</span>@if (!entry.IsEncrypted) { <span class="sc-chip sc-chip--warn" title="Stored without OS keystore protection">plain</span> }</td>
                            <td>@entry.Kind</td>
                            <td>@(SecretNames.Host(entry.Site) ?? entry.Site)</td>
                            <td>@entry.UsernameHint</td>
                            <td>@(entry.LastUsedUtc is { } used ? used.ToLocalTime().ToString("g") : "never")</td>
                            <td><button type="button" class="sc-btn sc-btn--sm sc-btn--danger" title="Delete" aria-label="Delete secret" @onclick="() => DeleteSecretAsync(entry.Name)">✕</button></td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!FilteredSecrets().Any()) { <p class="sc-muted">No matching credentials.</p> }
            </div>
        </dialog>

        <div class="sc-row">
            <div class="sc-field">
                <label class="sc-field__label" for="sc-secret-name">Name</label>
                <input id="sc-secret-name" class="sc-input sc-input--mono" placeholder="github-token" @bind="_secretName" />
            </div>
            <div class="sc-field">
                <label class="sc-field__label" for="sc-secret-value">Value</label>
                <input id="sc-secret-value" type="password" class="sc-input" autocomplete="off" placeholder="Paste the password, token, or key" @bind="_secretValue" />
            </div>
            <div class="sc-field">
                <label class="sc-field__label" for="sc-secret-site">Site (optional)</label>
                <input id="sc-secret-site" class="sc-input" placeholder="https://github.com" @bind="_secretSite" />
            </div>
            <div class="sc-field">
                <label class="sc-field__label" for="sc-secret-user">Username (optional)</label>
                <input id="sc-secret-user" class="sc-input" autocomplete="off" @bind="_secretUsername" />
            </div>
        </div>
        <div class="sc-row">
            <button type="button" class="sc-btn sc-btn--primary" @onclick="SaveSecretAsync">Save credential</button>
            <button type="button" class="sc-btn" @onclick="ImportPasswordsAsync">Import passwords (CSV)</button>
            <span class="sc-muted">Chrome, Edge, Firefox, Bitwarden, 1Password, and LastPass exports are recognized.</span>
            @if (_busy) { <span class="sc-spinner"></span> }
        </div>
    </section>
    </SettingsDialog>
    <SettingsDialog Id="connections" Title="Connected apps and tools" Description="MCP servers and your account connectors." Filter="@_settingsSearch" Message="@_message" IsError="@_messageIsError">
    <section class="sc-card">
        <h2 class="sc-card__title">Connected data (MCP servers)</h2>
        <p class="sc-card__copy">
            Connect local programs or shared HTTP servers that give the agent tools over the Model Context Protocol, such as a Talavine data hub.
            Native agents connect to them, and API models see their tools as
            <span class="sc-mono">mcp.server.tool</span>. Talavine can add itself here from its MCP Connectors page.
            The list lives in <span class="sc-mono">@State.Paths.McpServersPath</span>.
        </p>
        @foreach (var problem in _mcpProblems)
        {
            <div class="sc-notice sc-notice--error" role="alert">@problem</div>
        }
        @if (_mcpServers.Count == 0)
        {
            <p class="sc-muted">No servers connected.</p>
        }
        else
        {
            <table class="sc-table">
                <thead><tr><th>Name</th><th>Command or URL</th><th>Arguments</th><th>Environment</th><th>Flags</th><th></th></tr></thead>
                <tbody>
                    @foreach (var server in _mcpServers)
                    {
                        var entry = server;
                        <tr>
                            <td><span class="sc-mono">@entry.Name</span></td>
                            <td><span class="sc-mono">@(entry.Url ?? entry.Launch?.Command)</span></td>
                            <td><span class="sc-mono">@string.Join(" ", entry.Launch?.Arguments ?? [])</span></td>
                            <td><span class="sc-mono">@string.Join(", ", entry.Launch?.EnvironmentVariables.Keys ?? [])</span></td>
                            <td>@if (entry.Trusted) { <span class="sc-chip sc-chip--warn" title="Its read-only claims skip approval">trusted</span> } @if (entry.Required) { <span class="sc-chip sc-chip--ok">required</span> }</td>
                            <td><button type="button" class="sc-btn sc-btn--sm sc-btn--danger" title="Remove" aria-label="Remove MCP server" disabled="@(_busy || State.AnyTurnRunning)" @onclick="() => RemoveMcpServerAsync(entry.Name)">✕</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        <div class="sc-row">
            <div class="sc-field"><label class="sc-field__label" for="sc-mcp-name">Name</label><input id="sc-mcp-name" class="sc-input sc-input--mono" placeholder="talavine" @bind="_mcpName" /></div>
            <div class="sc-field"><label class="sc-field__label" for="sc-mcp-transport">Connection</label><select id="sc-mcp-transport" class="sc-input" @bind="_mcpTransport"><option value="stdio">Local program (stdio)</option><option value="http">Streamable HTTP</option></select></div>
            @if (_mcpHttp)
            {
                <div class="sc-field"><label class="sc-field__label" for="sc-mcp-url">Endpoint URL</label><input id="sc-mcp-url" class="sc-input sc-input--mono" placeholder="http://127.0.0.1:9123/mcp" @bind="_mcpUrl" /></div>
                <div class="sc-field"><label class="sc-field__label" for="sc-mcp-bearer">Bearer credential reference (optional)</label><input id="sc-mcp-bearer" class="sc-input sc-input--mono" placeholder="{{secret:hub-token}}" @bind="_mcpBearer" /></div>
            }
            else
            {
            <div class="sc-field"><label class="sc-field__label" for="sc-mcp-command">Command</label><input id="sc-mcp-command" class="sc-input sc-input--mono" @bind="_mcpCommand" /></div>
            <div class="sc-field"><label class="sc-field__label" for="sc-mcp-args">Arguments (one per line)</label><textarea id="sc-mcp-args" class="sc-input sc-input--mono" @bind="_mcpArguments"></textarea></div>
            <div class="sc-field"><label class="sc-field__label" for="sc-mcp-env">Environment (NAME=value per line)</label><textarea id="sc-mcp-env" class="sc-input sc-input--mono" @bind="_mcpEnvironment"></textarea></div>
            }
        </div>
        <div class="sc-row">
            <label class="sc-toggle"><input type="checkbox" @bind="_mcpTrusted" /><span class="sc-toggle__track"></span><span>Trust its read-only labels (its read-only tools then run without approval)</span></label>
            <label class="sc-toggle"><input type="checkbox" @bind="_mcpRequired" /><span class="sc-toggle__track"></span><span>Required (Codex stops instead of running without it)</span></label>
        </div>
        <label class="sc-toggle">
            <input type="checkbox" aria-label="Allow Codex app connectors" checked="@_allowCodexApps" disabled="@(_busy || State.AnyTurnRunning)"
                   @onchange="e => SetAllowCodexAppsAsync((bool)e.Value!)" />
            <span class="sc-toggle__track"></span>
            <span>Allow Codex app connectors</span>
        </label>
        <p class="sc-muted">Codex can also load the connectors you linked in your own Codex app and answer from their live data. This switch controls those app connectors. Additional MCP servers from your Codex configuration can still load. Each Codex turn names this host's configured servers and reports preflight or startup failures.</p>
        <label class="sc-toggle">
            <input type="checkbox" aria-label="Allow claude.ai connectors" checked="@_allowClaudeAi" disabled="@(_busy || State.AnyTurnRunning)"
                   @onchange="e => SetAllowClaudeAiAsync((bool)e.Value!)" />
            <span class="sc-toggle__track"></span>
            <span>Allow claude.ai connectors</span>
        </label>
        <p class="sc-muted">Claude Code can also load the connectors linked on your claude.ai account, such as Gmail or Google Drive, and answer from your live accounts instead of the data you connected here. This switch controls those connectors. MCP servers from your Claude Code configuration can still load.</p>
        <p class="sc-muted">For HTTP authentication, save the credential under Credentials and enter its {{secret:name}} reference above. Environment fields for local programs are saved as plain text; keep passwords and tokens out of them.</p>
        <button type="button" class="sc-btn sc-btn--primary" disabled="@(_busy || State.AnyTurnRunning)" @onclick="SaveMcpServerAsync">Save server</button>
    </section>
    </SettingsDialog>
    </div>
    <details class="sc-settings-more" open="@(!string.IsNullOrWhiteSpace(_settingsSearch))">
    <summary>More settings <span class="sc-muted">Work limits, browser, attachments and advanced options</span></summary>
    <div class="sc-settings-grid">
    <SettingsDialog Id="local-models" Title="Local models" Description="Set up Ollama, download models and choose fallbacks." Filter="@_settingsSearch" Message="@_message" IsError="@_messageIsError">
        <OllamaSetupPanel OnSaved="SourcesChangedAsync" />
    </SettingsDialog>
    <SettingsDialog Id="work" Title="Work limits and verification" Description="Time, tool calls, tokens and completion checks." Filter="@_settingsSearch" Message="@_message" IsError="@_messageIsError">
    <section class="sc-card">
        <h2 class="sc-card__title">Work limits and verification</h2>
        <p class="sc-card__copy">Limits apply across all models in a job. Zero means unlimited. Verification checks run after the model finishes; a finished answer alone does not prove the task is complete.</p>
        <div class="sc-row">
            <div class="sc-field"><label class="sc-field__label" for="sc-limit-minutes">Time limit (minutes)</label><input id="sc-limit-minutes" class="sc-input" type="number" min="0" @bind="_limitMinutes" /></div>
            <div class="sc-field"><label class="sc-field__label" for="sc-limit-tools">Tool calls</label><input id="sc-limit-tools" class="sc-input" type="number" min="0" @bind="_limitTools" /></div>
            <div class="sc-field"><label class="sc-field__label" for="sc-limit-tokens">Reported tokens</label><input id="sc-limit-tokens" class="sc-input" type="number" min="0" @bind="_limitTokens" /></div>
            <div class="sc-field"><label class="sc-field__label" for="sc-repair-attempts">Verification repair attempts</label><input id="sc-repair-attempts" class="sc-input" type="number" min="0" max="10" @bind="_repairAttempts" /></div>
        </div>
        <p class="sc-muted">Token limits depend on provider usage reports. Providers that do not report usage show it as unavailable.</p>
        @foreach (var row in _checks)
        {
            var check = row;
            <div class="sc-row">
                <div class="sc-field"><label class="sc-field__label">Check name</label><input class="sc-input" aria-label="Check name" @bind="check.Name" /></div>
                <div class="sc-field"><label class="sc-field__label">Executable</label><input class="sc-input" aria-label="Check executable" placeholder="dotnet" @bind="check.FileName" /></div>
                <div class="sc-field"><label class="sc-field__label">Arguments (one per line)</label><textarea class="sc-input" aria-label="Check arguments" placeholder="test" @bind="check.Arguments"></textarea></div>
                <div class="sc-field"><label class="sc-field__label">Required output (optional)</label><input class="sc-input" aria-label="Required check output" @bind="check.RequiredOutput" /></div>
                <button type="button" class="sc-btn sc-btn--sm sc-btn--danger" @onclick="() => _checks.Remove(check)">Remove check</button>
            </div>
        }
        <button type="button" class="sc-btn" @onclick="() => _checks.Add(new())">Add verification check</button>
    </section>
<button type="button" class="sc-btn sc-btn--primary" disabled="@(_busy || State.AnyTurnRunning)" @onclick="SaveRuntimeAsync">Save work settings</button>
    </SettingsDialog>
    <SettingsDialog Id="computer" Title="Browser and computer" Description="Chrome profiles and computer control." Filter="@_settingsSearch" Message="@_message" IsError="@_messageIsError">
    <section class="sc-card">

@implements IDisposable
@inject AppState State
@inject NavigationManager Nav

<aside class="sc-sidebar">
    <div class="sc-sidebar__brand"><img class="sc-mark" src="brand/swarmcode-mark.svg" alt="" width="22" height="22" /><span>Talavine Code</span></div>

    <RepositoryPicker />

    <a class="sc-sidebar__item @(_activePath.StartsWith("apps", StringComparison.Ordinal) ? "sc-sidebar__item--active" : "")" href="/apps">My apps</a>
    <a class="sc-sidebar__item" href="/history">Search session history</a>
    <a class="sc-sidebar__item" href="/peers">Peers</a>

    <button type="button" class="sc-btn sc-btn--primary sc-btn--block" @onclick="NewSessionAsync" title="Ctrl/Cmd+N">
        New session
    </button>

    <div class="sc-sidebar__section sc-sidebar__section--grow">
        <div class="sc-sidebar__label">Sessions</div>
        @if (State.Workspace is null)
        {
            <div class="sc-muted sc-sidebar__item">Open a repository to see its sessions.</div>
        }
        else if (_rows.Count == 0)
        {
            <div class="sc-muted sc-sidebar__item">No sessions yet.</div>
        }
        <div role="tree" aria-label="Sessions" class="sc-tree">
        @foreach (var r in _rows)
        {
            var row = r;
            var session = row.Session;
            var running = IsWorking(session.Id);
            var hiddenWorking = row.Collapsed ? row.Descendants.Count(IsWorking) : 0;
            var active = session.Id == _activeId;
            var confirming = _confirmDeleteId == session.Id;
            var independent = State.Agents.Get(session.Id)?.Independent == true;
            <div role="treeitem" aria-level="@(row.Depth + 1)" aria-expanded="@(row.HasChildren ? (!row.Collapsed).ToString().ToLowerInvariant() : null)"
                 aria-selected="@(active ? "true" : "false")"
                 class="sc-sidebar__item sc-tree__row @(row.Depth > 0 ? "sc-tree__row--child" : "") @(active ? "sc-sidebar__item--active" : "") @(running || hiddenWorking > 0 ? "sc-sidebar__item--running" : "") @(confirming ? "sc-sidebar__item--confirm" : "")"
                 style="--sc-tree-depth:@row.Depth"
                 @onclick="() => Open(session.Id)">
                @if (row.HasChildren)
                {
                    <button type="button" class="sc-tree__toggle @(row.Collapsed ? "sc-tree__toggle--collapsed" : "")"
                            title="@(row.Collapsed ? "Show" : "Hide") @row.ChildCount agent session@(row.ChildCount == 1 ? "" : "s")"
                            aria-label="@(row.Collapsed ? "Expand" : "Collapse") @session.Title"
                            @onclick="() => ToggleCollapsed(session.Id)" @onclick:stopPropagation="true"><span class="sc-tree__chevron" aria-hidden="true"></span></button>
                }
                else
                {
                    <span class="sc-tree__spacer" aria-hidden="true"></span>
                }
                <span class="sc-sidebar__text">
                    <span class="sc-sidebar__title" title="@session.Title">@session.Title</span>
                    <span class="sc-sidebar__meta">
                        <span>@AppNavigation.RelativeTime(session.LastActivityUtc)</span>
                        @if (independent)
                        {
                            <span class="sc-chip" title="Independent follow-up work an agent started on its own">follow-up</span>
                        }
                        @if (row.Collapsed)
                        {
                            <span class="sc-chip @(hiddenWorking > 0 ? "sc-chip--accent" : "")" title="Folded agent sessions">
                                @(hiddenWorking > 0 ? $"{hiddenWorking} working" : $"+{row.Descendants.Count}")
                            </span>
                        }
                        @if (!string.IsNullOrEmpty(session.LaneName))
                        {
                            <span class="sc-chip">@session.LaneName</span>
                        }
                    </span>
                </span>
                @if (confirming)
                {
                    <span class="sc-sidebar__confirm" @onclick:stopPropagation="true">
                        <button type="button" class="sc-btn sc-btn--danger sc-btn--sm" @onclick="() => DeleteAsync(session.Id)">Delete</button>
                        <button type="button" class="sc-btn sc-btn--sm" @onclick="() => _confirmDeleteId = null">Keep</button>
                    </span>
                }
                else
                {
                    <button type="button" class="sc-sidebar__action" title="@(row.HasChildren ? "Delete session and its agent sessions" : "Delete session")" aria-label="Delete session"
                            @onclick="() => _confirmDeleteId = session.Id" @onclick:stopPropagation="true">✕</button>
                }
            </div>
        }
        </div>
    </div>

    <div class="sc-sidebar__footer">
        <a class="sc-sidebar__item @(_activePath == "agents" ? "sc-sidebar__item--active" : "") @(_runningAgents > 0 ? "sc-sidebar__item--running" : "")" href="/agents">
            Agents @if (_runningAgents > 0) { <span class="sc-chip sc-chip--accent">@_runningAgents working</span> }
        </a>
        <a class="sc-sidebar__item @(_activePath == "schedules" ? "sc-sidebar__item--active" : "")" href="/schedules">Schedules</a>
        @if (State.SelfImprovement is { } loop)
        {
            <a class="sc-sidebar__item @(_activePath == "self-improvement" ? "sc-sidebar__item--active" : "") @(loop.IsRunning ? "sc-sidebar__item--running" : "")" href="/self-improvement">
                Self-improvement @if (loop.IsRunning) { <span class="sc-chip sc-chip--accent">working</span> }
            </a>
        }
        <a class="sc-sidebar__item @(_activePath == "settings" ? "sc-sidebar__item--active" : "")" href="/settings">Settings <span class="sc-kbd">@SwarmCode.App.Services.PlatformText.SettingsShortcut</span></a>
        <button type="button" class="sc-sidebar__item" @onclick="CycleTheme" title="Cycle theme: system, light, dark">
            <span>@ThemeGlyph</span> <span>Theme: @Theme</span>
        </button>
    </div>
</aside>

@code {
    private IReadOnlyList<SessionTreeRow> _rows = [];
    private HashSet<string> _working = new(StringComparer.Ordinal);
    private int _runningAgents;
    private string? _activeId;
    private string _activePath = "";
    private string? _confirmDeleteId;
    private int _refreshState; // 0 idle, 1 running, 2 running + rerun requested

    private string Theme => State.Preferences.Current.Theme is "light" or "dark" ? State.Preferences.Current.Theme : "system";
    private string ThemeGlyph => Theme switch { "light" => "☀", "dark" => "☾", _ => "◐" };

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnChanged;
        State.Preferences.Changed += OnChanged;
        State.Agents.Changed += OnAgentsChanged;
        Nav.LocationChanged += OnLocationChanged;
        UpdateLocation();
        await RefreshAsync();
    }

    private void UpdateLocation()
    {
        var rel = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/');
        _activePath = rel;
        _activeId = AppNavigation.SessionIdFrom(rel);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = InvokeAsync(() => { UpdateLocation(); StateHasChanged(); });
    }

    // Events arrive on background threads and can be frequent (streaming), so refreshes are coalesced.
    private void OnChanged() => _ = InvokeAsync(RefreshAsync);

    // Agent activity changes often; only the running count matters here.
    private void OnAgentsChanged()
    {
        var running = State.Agents.RunningCount;
        if (running != _runningAgents) _ = InvokeAsync(RefreshAsync);
    }

    private async Task RefreshAsync()
    {
        if (Interlocked.CompareExchange(ref _refreshState, 1, 0) != 0)
        {
            Interlocked.Exchange(ref _refreshState, 2);
            return;
        }
        try
        {
            do
            {
                Interlocked.Exchange(ref _refreshState, 1);
                var root = State.RepositoryRoot;
                var sessions = root is null ? [] : await Task.Run(() => State.Sessions.ListAsync(root));
                var collapsed = State.Preferences.Current.CollapsedSessionIds.ToHashSet(StringComparer.Ordinal);
                _rows = SessionTree.Flatten(sessions, collapsed.Contains);
                _working = sessions.Select(s => s.Id).Where(id => State.TryGetRunner(id)?.IsRunning == true
                    || State.Agents.Get(id)?.State is SwarmCore.Coding.Agents.AgentState.Running or SwarmCore.Coding.Agents.AgentState.Queued)
                    .ToHashSet(StringComparer.Ordinal);
                _runningAgents = State.Agents.RunningCount;
                StateHasChanged();
                if (State.AnyTurnRunning) await Task.Delay(300);
            }
            while (Interlocked.CompareExchange(ref _refreshState, 0, 1) == 2);
        }
        catch (Exception ex)
        {
            MauiProgram.LogToFile($"Sidebar refresh failed: {ex.Message}");
            Interlocked.Exchange(ref _refreshState, 0);
        }
    }

    private void Open(string id) => Nav.NavigateTo(AppNavigation.SessionUrl(id));

    private bool IsWorking(string id) => _working.Contains(id);

    // Folding is per person and survives restarts; expanded is the default, so only folded ids are kept.
    private void ToggleCollapsed(string id) => State.Preferences.Update(p =>
    {
        if (!p.CollapsedSessionIds.Remove(id)) p.CollapsedSessionIds.Add(id);
    });

    private async Task NewSessionAsync()
    {
        if (State.Workspace is null)
        {
            Nav.NavigateTo("/");
            return;
        }
        var session = await State.NewSessionAsync();
        Nav.NavigateTo(AppNavigation.SessionUrl(session.Id));
    }

    private async Task DeleteAsync(string id)
    {
        _confirmDeleteId = null;
        await State.DeleteSessionAsync(id);
        if (State.Preferences.Current.CollapsedSessionIds.Contains(id)) State.Preferences.Update(p => p.CollapsedSessionIds.Remove(id));
        if (_activeId == id) Nav.NavigateTo("/");
    }

    private void CycleTheme()
    {
        var next = Theme switch { "system" => "light", "light" => "dark", _ => "system" };
        State.Preferences.Update(p => p.Theme = next);
    }

    public void Dispose()
    {
        State.Changed -= OnChanged;
        State.Preferences.Changed -= OnChanged;
        State.Agents.Changed -= OnAgentsChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}

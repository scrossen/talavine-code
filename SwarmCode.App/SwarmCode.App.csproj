<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <!-- Desktop heads only: Windows and Mac Catalyst. -->
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net11.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">net11.0-maccatalyst</TargetFrameworks>
    <!-- Lets a Windows machine with the Mac workload compile-check the Mac Catalyst head
         (`-p:SwarmCodeBuildMacCatalyst=true -f net11.0-maccatalyst`) without overriding
         TargetFrameworks on every referenced net11.0 project. Mirrors TalavineBuildMacCatalyst. -->
    <TargetFrameworks Condition="'$(SwarmCodeBuildMacCatalyst)' == 'true'">net11.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="'$(TargetFrameworks)' == ''">net11.0-maccatalyst</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>SwarmCode.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <ApplicationTitle>Talavine Code</ApplicationTitle>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <ApplicationId>com.swarmfamily.swarmcode</ApplicationId>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>10000</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">17.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

    <WindowsPackageType Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">None</WindowsPackageType>
    <WindowsAppSDKSelfContained Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">true</WindowsAppSDKSelfContained>
    <ProjectPriFileName Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">resources.pri</ProjectPriFileName>
    <ApplicationManifest Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">Platforms\Windows\app.manifest</ApplicationManifest>

    <UseXamlPreCompilation>false</UseXamlPreCompilation>
    <XamlPreCompilationEnabled>false</XamlPreCompilationEnabled>

    <!-- .NET 10 Windows App SDK build workarounds (mirrors Vibes.App / Talavine.App). -->
    <EnableMsixTooling>false</EnableMsixTooling>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxAutoIncrementPackageRevision>false</AppxAutoIncrementPackageRevision>

    <NoWarn>$(NoWarn);CS8618;NU1903</NoWarn>
  </PropertyGroup>

  <Target Name="CopyWindowsPriToPublishDirectory" AfterTargets="Publish" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <Error Condition="!Exists('$(TargetDir)resources.pri')" Text="Windows publish requires $(TargetDir)resources.pri for WinUI theme resources." />
    <Copy SourceFiles="$(TargetDir)resources.pri" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- The native bridge references the CLI executable. Its configuration file
       has the same publish name as the desktop host's; keep the host's copy. -->
  <Target Name="KeepDesktopHostPublishSettings" AfterTargets="ComputeResolvedFilesToPublishList"
          Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="$(MSBuildProjectDirectory)\..\SwarmCode\appsettings.json" />
    </ItemGroup>
  </Target>

  <!-- Resizetizer tracks the MauiIcon source but not its foreground; refresh when the artwork changes (mirrors Talavine.App). -->
  <Target Name="RefreshMauiIconForForegroundArtwork" AfterTargets="ResizetizeCollectItems" BeforeTargets="ResizetizeImages" Inputs="Resources\AppIcon\appiconfg.svg" Outputs="$(IntermediateOutputPath)mauiiconfg.stamp">
    <RemoveDir Directories="$(_MauiIntermediateImages)" Condition="Exists('$(_MauiIntermediateImages)')" />
    <Touch Files="$(_ResizetizerInputsFile)" Condition="Exists('$(_ResizetizerInputsFile)')" />
    <Touch Files="$(IntermediateOutputPath)mauiiconfg.stamp" AlwaysCreate="true" />
  </Target>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0-maccatalyst'">
    <RuntimeIdentifier>maccatalyst-arm64</RuntimeIdentifier>
    <ValidateXcodeVersion>false</ValidateXcodeVersion>
    <MdimportPath>/usr/bin/mdimport</MdimportPath>
    <TargetPlatformVersion>27.0</TargetPlatformVersion>
    <TrimMode Condition="'$(Configuration)' == 'Release'">partial</TrimMode>
    <MtouchLink Condition="'$(Configuration)' == 'Release'">SdkOnly</MtouchLink>
    <MtouchLink Condition="'$(Configuration)' != 'Release'">None</MtouchLink>
    <CodesignEntitlements Condition="'$(Configuration)' == 'Debug'">Platforms/MacCatalyst/Entitlements.Debug.plist</CodesignEntitlements>
    <CodesignEntitlements Condition="'$(Configuration)' != 'Debug'">Platforms/MacCatalyst/Entitlements.plist</CodesignEntitlements>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0-maccatalyst'">
    <FrameworkReference Remove="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- The RC2 Apple target records the manifest path but omits the file from
       its incremental inputs. Track edits so scene settings reach the bundle. -->
  <Target Name="TrackMacAppManifestChanges" BeforeTargets="_CompileAppManifest"
          Condition="'$(TargetFramework)' == 'net11.0-maccatalyst'">
    <ItemGroup>
      <_CompileAppManifestInputFile Include="$(AppBundleManifest)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#151D30" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#151D30" BaseSize="192,192" />
    <MauiAsset Include="appsettings.json" LogicalName="appsettings.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.1.2" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(TalavineMacMauiVersion)" Condition="'$(TargetFramework)' == 'net11.0-maccatalyst'" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(TalavineStableMauiVersion)" Condition="'$(TargetFramework)' != 'net11.0-maccatalyst'" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(TalavineMacMauiVersion)" Condition="'$(TargetFramework)' == 'net11.0-maccatalyst'" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(TalavineStableMauiVersion)" Condition="'$(TargetFramework)' != 'net11.0-maccatalyst'" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="11.0.0-rc.2.26504.105" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="11.0.0-rc.2.26504.105" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SwarmCode.Hosting\SwarmCode.Hosting.csproj" />
    <ProjectReference Include="..\SwarmCore\SwarmCore.Chat.Components\SwarmCore.Chat.Components.csproj" />
  </ItemGroup>

  <!--
    The console doubles as the vault bridge (swarmcode in MCP server mode) for native coding agents.
    The Windows head is framework-dependent, so referencing the console ships swarmcode.exe beside the app.
    A Mac Catalyst app is always self-contained and cannot reference a framework-dependent executable
    (NETSDK1150); that head publishes a separate self-contained console closure into its owned bundle.
  -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <ProjectReference Include="..\SwarmCode\SwarmCode.csproj" />
  </ItemGroup>

  <Target Name="BundleMacVaultBridge" BeforeTargets="_CodesignAppBundle"
          Condition="$([MSBuild]::IsOSPlatform('osx')) and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst' and '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_SwarmCodeBridgePublish>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)swarmcode-bridge-publish/'))</_SwarmCodeBridgePublish>
      <_SwarmCodeBridgeBundle>$(AppBundleDir)/Contents/Resources/SwarmCodeBridge</_SwarmCodeBridgeBundle>
      <_SwarmCodeBridgeFramework>net$(TargetFrameworkVersion.TrimStart('v'))</_SwarmCodeBridgeFramework>
      <_SwarmCodeBridgeSigningKey>$(_CodeSigningKey)</_SwarmCodeBridgeSigningKey>
      <_SwarmCodeBridgeSigningKey Condition="'$(_SwarmCodeBridgeSigningKey)' == ''">$(CodesignKey)</_SwarmCodeBridgeSigningKey>
      <_SwarmCodeBridgeSigningKey Condition="'$(_SwarmCodeBridgeSigningKey)' == '' and '$(Configuration)' == 'Debug'">-</_SwarmCodeBridgeSigningKey>
    </PropertyGroup>
    <Error Condition="'$(AppBundleDir)' == '' or !Exists('$(AppBundleDir)/Contents')" Text="Mac vault bridge requires the actual MAUI AppBundleDir before app signing." />
    <Error Condition="'$(_SwarmCodeBridgeSigningKey)' == ''" Text="Mac vault bridge requires the parent app's signing identity." />
    <RemoveDir Directories="$(_SwarmCodeBridgePublish)" />
    <MSBuild Projects="$(MSBuildProjectDirectory)/../SwarmCode/SwarmCode.csproj" Targets="Restore;Publish"
             Properties="Configuration=$(Configuration);TargetFramework=$(_SwarmCodeBridgeFramework);RuntimeIdentifier=osx-arm64;SelfContained=true;PublishSingleFile=false;PublishTrimmed=false;PublishDir=$(_SwarmCodeBridgePublish)"
             RemoveProperties="TargetFrameworks;RuntimeIdentifiers;UseMaui;CodesignEntitlements;ApplicationId;ApplicationTitle" />
    <Error Condition="!Exists('$(_SwarmCodeBridgePublish)/swarmcode') or !Exists('$(_SwarmCodeBridgePublish)/libhostfxr.dylib') or !Exists('$(_SwarmCodeBridgePublish)/libcoreclr.dylib')" Text="The Mac vault bridge publish lacks its executable or self-contained runtime closure." />
    <!-- Mixed managed/runtime payloads belong in Resources; Helpers treats every leaf as nested code. -->
    <RemoveDir Directories="$(AppBundleDir)/Contents/Helpers/SwarmCodeBridge;$(_SwarmCodeBridgeBundle)" />
    <ItemGroup><_SwarmCodeBridgeFile Include="$(_SwarmCodeBridgePublish)/**/*" /></ItemGroup>
    <Copy SourceFiles="@(_SwarmCodeBridgeFile)" DestinationFiles="@(_SwarmCodeBridgeFile->'$(_SwarmCodeBridgeBundle)/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Exec Command="bash &quot;$(MSBuildProjectDirectory)/../Installer/macOS/sign-swarmcode-bridge.sh&quot; &quot;$(_SwarmCodeBridgeBundle)&quot; &quot;$(_SwarmCodeBridgeSigningKey)&quot; &quot;$(MSBuildProjectDirectory)/Platforms/MacCatalyst/Bridge.entitlements.plist&quot;" />
  </Target>
</Project>

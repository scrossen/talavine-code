    // App events arrive for every runner event (each streamed chunk). Refreshes are coalesced: one runs at a time, a
    // change that arrives meanwhile reruns it once, and while a turn streams the reruns are spaced a second apart.
    private int _refreshState; // 0 idle, 1 running, 2 running + rerun requested
    private void OnChanged() => _ = InvokeAsync(RefreshOnChangeAsync);

    private async Task RefreshOnChangeAsync()
    {
        if (Interlocked.CompareExchange(ref _refreshState, 1, 0) != 0)
        {
            Interlocked.Exchange(ref _refreshState, 2);
            return;
        }
        try
        {
            do
            {
                Interlocked.Exchange(ref _refreshState, 1);
                await RefreshReturnDestinationAsync();
                await RefreshKeysAsync();
                await LoadDefaultFavoritesAsync();
                StateHasChanged();
                if (State.AnyTurnRunning) await Task.Delay(1000);
            }
            while (Interlocked.CompareExchange(ref _refreshState, 0, 1) == 2);
        }
        catch (Exception ex)
        {
            DesktopHost.LogToFile($"Settings refresh failed: {ex.Message}");
            Interlocked.Exchange(ref _refreshState, 0);
        }
    }


    <SettingsDialog Id="fallback" Title="Model handoff" Description="Fallback order, discovery and price limits." Filter="@_settingsSearch" Message="@_message" IsError="@_messageIsError">
    <section class="sc-card">
        <h2 class="sc-card__title">Lanes</h2>
        <p class="sc-card__copy">A lane is one model the agent can run on. Lanes higher in the list are tried first when a task is handed off.</p>
        @if (_lanes.Count == 0)
        {
            <p class="sc-muted">No custom lanes: the app is using lanes it detected automatically. Add one to take control.</p>
        }
        else
        {
            <table class="sc-table">
                <thead><tr><th>Name</th><th>Provider</th><th>Model</th><th>Description</th><th></th></tr></thead>
                <tbody>
                    @for (var i = 0; i < _lanes.Count; i++)
                    {
                        var index = i;
                        var row = _lanes[i];
                        var laneOff = NativeOff && IsNativeProvider(row.Provider);
                        <tr class="@(laneOff ? "sc-lane--off" : null)" title="@(laneOff ? NativeApprovalNote : null)">
                            <td><input class="sc-input" @bind="row.Name" aria-label="Lane name" /></td>
                            <td><input class="sc-input" list="sc-provider-ids" @bind="row.Provider" aria-label="Provider" /></td>
                            <td><input class="sc-input sc-input--mono" @bind="row.Model" aria-label="Model" /></td>
                            <td><input class="sc-input" @bind="row.Description" aria-label="Description" /></td>
                            <td>
                                <div class="sc-row">
                                    <button type="button" class="sc-btn sc-btn--sm" title="Move up" aria-label="Move up" @onclick="() => Move(index, -1)">↑</button>
                                    <button type="button" class="sc-btn sc-btn--sm" title="Move down" aria-label="Move down" @onclick="() => Move(index, 1)">↓</button>
                                    <button type="button" class="sc-btn sc-btn--sm sc-btn--danger" title="Remove" aria-label="Remove lane" @onclick="() => _lanes.RemoveAt(index)">✕</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (NativeOff && _lanes.Any(r => IsNativeProvider(r.Provider)))
            {
                <p class="sc-muted sc-note">Dimmed lanes are native agents. @NativeApprovalNote</p>
            }
        }
        <datalist id="sc-provider-ids">
            @foreach (var id in KnownProviders) { <option value="@id"></option> }
        </datalist>

        <div class="sc-row">
            <button type="button" class="sc-btn" @onclick="AddLane">Add lane</button>
        </div>

        <div class="sc-row">
            <div class="sc-field">
                <label class="sc-field__label" for="sc-default-lane">Default lane</label>
                <select id="sc-default-lane" class="sc-select" @bind="_laneDefault">
                    <option value="">First lane</option>
                    @foreach (var n in LaneNames()) { <option value="@n">@n</option> }

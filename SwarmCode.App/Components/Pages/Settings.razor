    private void LoadRuntimeSettings()
    {
        var limits = SettingsFile.ReadCodingSection<CodingExecutionLimits>("ExecutionLimits");
        _limitMinutes = limits.Timeout > TimeSpan.Zero ? (int)Math.Ceiling(limits.Timeout.TotalMinutes) : 0;
        _limitTools = limits.MaxToolCalls;
        _limitTokens = limits.MaxCumulativeTokens;
        _limitIterations = limits.MaxIterations;
        var acceptance = SettingsFile.ReadCodingSection<CodingAcceptanceOptions>("Acceptance");
        _repairAttempts = acceptance.MaxRepairAttempts;
        _checks = acceptance.Commands.Select(c => new CheckRow { Name = c.Name, FileName = c.FileName, Arguments = string.Join('\n', c.Arguments), WorkingDirectory = c.WorkingDirectory, TimeoutSeconds = c.TimeoutSeconds, ExpectedExitCode = c.ExpectedExitCode, RequiredOutput = c.RequiredOutput }).ToList();
        var attachments = SettingsFile.ReadCodingSection<CodingAttachmentOptions>("AttachmentLimits");
        _attachmentFileMb = attachments.MaxFileBytes / 1048576m;
        _attachmentTotalMb = attachments.MaxTotalBytes / 1048576m;
        _attachmentCount = attachments.MaxFiles;
        _attachmentText = attachments.MaxTextCharacters;
        _computer = SettingsFile.ReadCodingSection<CodingComputerOptions>("Computer");
        _fallbackDiscovery = SettingsFile.ReadCodingSection<CodingFallbackDiscoveryOptions>("FallbackDiscovery");
        _discoveryProviders = string.Join(", ", _fallbackDiscovery.Providers);
        _discoveryNamespaces = string.Join(", ", _fallbackDiscovery.PreferredModelNamespaces);
        if (string.IsNullOrWhiteSpace(_computer.BrowserProfileDirectory)) _computer.BrowserProfileDirectory = Path.Combine(State.Paths.RootDirectory, "browser", "chrome");
        _allowCodexApps = SettingsFile.ReadAllowCodexAppConnectors();
        _allowClaudeAi = SettingsFile.ReadAllowClaudeAiConnectors();
        _permissionRules = SettingsFile.ReadPermissionRules();
    }


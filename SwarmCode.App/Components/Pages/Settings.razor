        <label class="sc-toggle">
            <input id="sc-response-memory" type="checkbox" @bind="_fallbackDiscovery.RememberResponses" />
            <span class="sc-toggle__track"></span><span>Remember model responses and use them to rank alternatives</span>
        </label>
        <div class="sc-row">
            <div class="sc-field"><label class="sc-field__label" for="sc-discovery-providers">Catalog providers</label><input id="sc-discovery-providers" class="sc-input" @bind="_discoveryProviders" placeholder="OpenRouter" /></div>
            <div class="sc-field"><label class="sc-field__label" for="sc-discovery-namespaces">Preferred model families</label><input id="sc-discovery-namespaces" class="sc-input" @bind="_discoveryNamespaces" placeholder="Comma-separated catalog namespaces" /></div>
        </div>
        <div class="sc-row">
            <div class="sc-field"><label class="sc-field__label" for="sc-discovery-count">Candidates per request</label><input id="sc-discovery-count" class="sc-input" type="number" min="1" max="10" @bind="_fallbackDiscovery.MaxCandidates" /></div>
            <div class="sc-field"><label class="sc-field__label" for="sc-discovery-input">Max input price per million tokens ($)</label><input id="sc-discovery-input" class="sc-input" type="number" min="0" step="0.01" @bind="_fallbackDiscovery.MaxInputPricePerMillionUsd" /></div>
            <div class="sc-field"><label class="sc-field__label" for="sc-discovery-output">Max output price per million tokens ($)</label><input id="sc-discovery-output" class="sc-input" type="number" min="0" step="0.01" @bind="_fallbackDiscovery.MaxOutputPricePerMillionUsd" /></div>
        </div>
        <p class="sc-muted">Catalog prices and tool support filter candidates; they do not prove quality or willingness. The chat names every model tried and retains its result.</p>
        <button class="sc-btn sc-btn--primary" disabled="@_busy" @onclick="SaveFallbackDiscoveryAsync">Save model search</button>
    </section>
    </SettingsDialog>
    <SettingsDialog Id="extensions" Title="Extensions" Description="Inspect commands, skills and hooks." Filter="@_settingsSearch" Message="@_message" IsError="@_messageIsError">
<ExtensionsCard />

    private async Task DeleteSecretAsync(string name)
    {
        try
        {
            await State.Vault.DeleteAsync(name);
            await RefreshSecretsAsync();
            Show($"Deleted {name}.", false);
        }
        catch (Exception ex) { Show($"Could not delete {name}: {ex.Message}", true); }
    }

    private async Task ImportPasswordsAsync()
    {
        _busy = true;
        try
        {
            var picked = await DesktopPlatform.PickFileAsync("Choose a password export (CSV)", "csv");
            if (picked is null) return;
            var summary = await State.PasswordImporter.ImportFileAsync(picked);
            await RefreshSecretsAsync();
            Show(summary.Describe(), !summary.Success);
        }
        catch (Exception ex) { Show($"Import failed: {ex.Message}", true); }
        finally { _busy = false; }
    }

    private IEnumerable<string> LaneNames()
    {
        var names = _lanes.Select(l => l.Name).Where(n => !string.IsNullOrWhiteSpace(n));
        if (State.Workspace is { } ws) names = names.Concat(ws.Lanes.Select(l => l.Name));
        return names.Distinct(StringComparer.OrdinalIgnoreCase);
    }

    private void AddLane() => _lanes.Add(new LaneRow());

    private void Move(int index, int delta)
    {
        var to = index + delta;
        if (to < 0 || to >= _lanes.Count) return;
        (_lanes[index], _lanes[to]) = (_lanes[to], _lanes[index]);
    }

    private async Task RefreshModelHistoryAsync()
    {
        try
        {
            var workspace = State.Workspace;
            if (workspace?.Services.GetService(typeof(IModelResponseMemory)) is not IModelResponseMemory memory)
            { _modelHistory = []; _modelHistoryError = null; return; }
            var scopeId = workspace.CodingOptions.ProfileId.ToString("N");
            _modelHistory = await Task.Run(async () => ModelResponseLearning.Summarize(await memory.ReadAsync(scopeId)));
            _modelHistoryError = null;
        }
        catch (Exception) { _modelHistoryError = "Response history could not be loaded. Existing evidence has not been replaced."; }
    }

    private async Task SaveFallbackDiscoveryAsync()
    {
        if (State.AnyTurnRunning) { Show("Finish the running request before changing model search.", true); return; }
        _busy = true;
        try
        {
            var saved = new CodingFallbackDiscoveryOptions
            {
                Enabled = _fallbackDiscovery.Enabled,
                RememberResponses = _fallbackDiscovery.RememberResponses,
                Providers = _discoveryProviders.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).Distinct(StringComparer.OrdinalIgnoreCase).ToList(),
                PreferredModelNamespaces = _discoveryNamespaces.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).Distinct(StringComparer.OrdinalIgnoreCase).ToList(),
                MaxCandidates = Math.Clamp(_fallbackDiscovery.MaxCandidates, 1, 10),
                MaxInputPricePerMillionUsd = Math.Max(0, _fallbackDiscovery.MaxInputPricePerMillionUsd),
                MaxOutputPricePerMillionUsd = Math.Max(0, _fallbackDiscovery.MaxOutputPricePerMillionUsd),
            };
            await Task.Run(() => SettingsFile.WriteCodingSection("FallbackDiscovery", saved));
            var ok = State.Workspace is null || await State.ReloadWorkspaceAsync();
            Show(ok ? "Fallback model search saved." : "Model search saved, but the repository failed to reload.", !ok);
        }
        catch (Exception ex) { Show("Could not save model search: " + ex.Message, true); }
        finally { _busy = false; }
    }

    private async Task SaveLanesAsync()
    {
        var error = ValidateLanes();
        if (error is not null) { Show(error, true); return; }
        _busy = true;
        try
        {
            var options = new CodingLaneOptions
            {
                Lanes = _lanes.Select((r, i) => new CodingLane(r.Name.Trim(), r.Provider.Trim(), r.Model.Trim())
                {
                    Description = string.IsNullOrWhiteSpace(r.Description) ? null : r.Description.Trim(),
                    Priority = i,
                }).ToList(),
                DefaultLane = string.IsNullOrWhiteSpace(_laneDefault) ? null : _laneDefault,
                HandOffOnRefusal = _handOff,
                MaxLanesPerRequest = Math.Clamp(_maxLanes, 1, 10),
            };
            await Task.Run(() => SettingsFile.WriteLanes(options));
            _userLanes = options.Lanes.ToArray();
            State.Preferences.Update(p => p.HandOffOnRefusal = _handOff);
            var ok = await State.ReloadWorkspaceAsync();
            Show(ok || State.Workspace is null ? "Lanes saved." : "Lanes saved, but the repository failed to reload.", !ok && State.Workspace is not null);
        }
        catch (Exception ex) { Show($"Could not save lanes: {ex.Message}", true); }
        finally { _busy = false; }
    }

    private string? ValidateLanes()
    {
        foreach (var r in _lanes)
        {
            if (string.IsNullOrWhiteSpace(r.Name) || string.IsNullOrWhiteSpace(r.Provider) || string.IsNullOrWhiteSpace(r.Model))
                return "Every lane needs a name, a provider, and a model.";
        }
        var dup = _lanes.GroupBy(r => r.Name.Trim(), StringComparer.OrdinalIgnoreCase).FirstOrDefault(g => g.Count() > 1);
        return dup is null ? null : $"Lane names must be unique ({dup.Key} appears twice).";
    }

    private async Task ResetLanesAsync()
    {
        _busy = true;
        try
        {
            await Task.Run(() => SettingsFile.WriteLanes(new CodingLaneOptions { HandOffOnRefusal = _handOff }));
            LoadLanes();
            await State.ReloadWorkspaceAsync();
            Show("Lanes reset to the ones detected on this computer.", false);
        }
        catch (Exception ex) { Show($"Could not reset lanes: {ex.Message}", true); }
        finally { _busy = false; }
    }


@using SwarmCore.Coding.Extensions
@* Asks once per hooks.json content before a repository's hooks may run. Hidden when there is nothing to decide. *@

@if (_inspection is { NeedsApproval: true } inspection && !_dismissed)
{
    <div class="sc-notice sc-notice--warn sess-hooks-prompt" role="alert">
        <div class="sc-grow">
            <strong>This repository wants to run hooks.</strong>
            <span>They run on this computer with your permissions whenever their event fires. Allow?</span>
            <ul class="sc-mono sess-hooks-prompt__list">
                @foreach (var hook in inspection.Hooks)
                {
                    <li>@hook.Event@(hook.Matcher is null ? "" : $" [{hook.Matcher}]"): @hook.Command</li>
                }
            </ul>
            @if (_error is not null) { <span>@_error</span> }
        </div>
        <button type="button" class="sess-btn sess-btn--primary" disabled="@_busy" @onclick="AllowAsync">Allow</button>
        <button type="button" class="sess-btn" disabled="@_busy" @onclick="() => _dismissed = true">Not now</button>
    </div>
}

@code {
    [Parameter] public WorkspaceHost? Workspace { get; set; }

    private WorkspaceHost? _inspected;
    private RepoHookInspection? _inspection;
    private bool _dismissed, _busy;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        if (ReferenceEquals(Workspace, _inspected)) return;
        _inspected = Workspace;
        _dismissed = false;
        _error = null;
        _inspection = null;
        if (Workspace?.Services.GetService<ICodingHookSource>() is not { } source) return;
        var root = Workspace.RepositoryRoot;
        try { _inspection = await Task.Run(() => source.InspectRepositoryAsync(root)); }
        catch (Exception ex) { MauiProgram.LogToFile($"Could not inspect repository hooks: {ex.Message}"); }
    }

    private async Task AllowAsync()
    {
        if (_inspection?.Sha256 is not { } sha || Workspace?.Services.GetService<ICodingHookApprovalStore>() is not { } approvals) return;
        _busy = true;
        try
        {
            var root = Workspace.RepositoryRoot;
            await Task.Run(() => approvals.ApproveAsync(root, sha));
            var source = Workspace.Services.GetRequiredService<ICodingHookSource>();
            _inspection = await Task.Run(() => source.InspectRepositoryAsync(root));
        }
        catch (Exception ex) { _error = "Could not save the approval: " + ex.Message; }
        finally { _busy = false; }
    }
}

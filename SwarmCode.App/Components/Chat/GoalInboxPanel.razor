        var when = DateOnly.FromDateTime(recorded.DateTime) == report.Day ? recorded.ToString("t") : SwarmCode.App.Services.AppNavigation.DateAndTime(report.RecordedUtc.UtcDateTime);
        return report.Revision > 1 ? when + " · revision " + report.Revision : when;
    }
    /// <summary>Tooltip for the Updated stamp: the full local time, and which rewrite of the day's report this is.</summary>
    private static string UpdatedTitle(GoalReport report)
    {

        <div class="sc-row">
            <button type="button" class="sc-btn sc-btn--primary" @onclick="SaveLanesAsync">Save lanes</button>
            <button type="button" class="sc-btn" @onclick="ResetLanesAsync">Reset to detected defaults</button>

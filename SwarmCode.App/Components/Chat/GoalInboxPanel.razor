    /// <summary>Reloads the visible range from the start; a poll keeps what "Show earlier" already loaded.</summary>
    private async Task RefreshLedgerAsync(bool reset)
    {
        if (Ledger is not { } ledger || _selected is not { } goal || _disposed) return;
        if (_ledgerLoading) { _ledgerRefreshAgain = true; return; }
        _ledgerLoading = true;
        var take = reset ? LedgerPage : Math.Max(LedgerPage, _ledgerEntries.Count);
        var include = _includeObservations;
        try
        {
            var page = await Task.Run(() => ledger.ReadAsync(goal, 0, take, include, _lifetime.Token));
            var openable = await Task.Run(() => Openable(page));
            if (goal != _selected || include != _includeObservations) return;
            _ledger = page; _ledgerEntries = page?.Entries.ToList() ?? []; _openableFiles = openable; _ledgerError = null;
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception) { _ledgerError = "What's been done could not refresh. Try Refresh again."; }
        finally
        {
            _ledgerLoading = false;
            // A filter change that arrived while a poll was loading must not be lost.
            if (_ledgerRefreshAgain) { _ledgerRefreshAgain = false; await RefreshLedgerAsync(reset: true); }
        }
    }
    private async Task LoadMoreLedgerAsync()
    {
        if (Ledger is not { } ledger || _selected is not { } goal || _ledger is not { HasMore: true } || _ledgerLoading) return;
        _ledgerLoading = true;
        var include = _includeObservations; var offset = _ledgerEntries.Count;
        try
        {
            var page = await Task.Run(() => ledger.ReadAsync(goal, offset, LedgerPage, include, _lifetime.Token));
            var openable = await Task.Run(() => Openable(page));
            if (goal != _selected || include != _includeObservations || page is null) return;
            var known = _ledgerEntries.Select(entry => entry.Key).ToHashSet(StringComparer.Ordinal);
            _ledgerEntries.AddRange(page.Entries.Where(entry => known.Add(entry.Key)));
            _openableFiles.UnionWith(openable);
            _ledger = page;
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception) { _ledgerError = "Earlier entries could not load. Try again."; }
        finally { _ledgerLoading = false; }
    }
    private static HashSet<string> Openable(CodingGoalLedgerPage? page)
    {
        var files = new HashSet<string>(StringComparer.Ordinal);
        if (page is null) return files;
        foreach (var file in page.Entries.SelectMany(entry => entry.Files))
            if (System.IO.Path.IsPathRooted(file) && System.IO.File.Exists(file)) files.Add(file);
        return files;
    }
    private string FileLabel(string file)
    {
        var root = _ledger?.RepositoryRoot?.TrimEnd('/', '\\');
        if (!string.IsNullOrEmpty(root) && file.Length > root.Length && file.StartsWith(root, StringComparison.Ordinal)
            && file[root.Length] is '/' or '\\')
            return file[(root.Length + 1)..];
        return file;
    }
    private async Task OpenFileAsync(string file)
    {
        try { if (!await SwarmCode.App.Services.DesktopPlatform.OpenFileAsync(file)) _ledgerError = "No app could open " + FileLabel(file) + "."; }
        catch (Exception ex) { _ledgerError = ex.Message; }
    }

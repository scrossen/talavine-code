<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SwarmCore.PersonalMemory</RootNamespace>
    <Description>SwarmCore Personal Memory - shared, host-persisted memory of the people an assistant serves: governed capture (claims), background consolidation ("dreaming") into facts, a bounded profile digest, recall injection, and governed memory tools.</Description>
    <Authors>Scott Crossen</Authors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0-rc.2.26504.105" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0-rc.2.26504.105" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SwarmCore.Abstractions\SwarmCore.Abstractions.csproj" />
    <ProjectReference Include="..\SwarmCore.Knowledge\SwarmCore.Knowledge.csproj" />
    <ProjectReference Include="..\SwarmCore.Agent\SwarmCore.Agent.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SwarmCore.Knowledge.Tests" />
  </ItemGroup>

</Project>

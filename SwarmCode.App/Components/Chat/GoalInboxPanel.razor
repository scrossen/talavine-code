        return report.Revision > 1 ? "Revision " + report.Revision + " of this day's report, recorded " + recorded : "Recorded " + recorded;
    }
    /// <summary>Paragraphs of report prose: blank lines separate them; single line breaks stay inside one.</summary>
    private static IEnumerable<string> Paragraphs(string text)
        => System.Text.RegularExpressions.Regex.Split(text.Replace("\r\n", "\n"), "\n[ \t]*\n+").Select(paragraph => paragraph.Trim()).Where(paragraph => paragraph.Length > 0);
    private static readonly System.Text.RegularExpressions.Regex LinkPattern = new("https?://[^\\s<>\"]+", System.Text.RegularExpressions.RegexOptions.IgnoreCase | System.Text.RegularExpressions.RegexOptions.Compiled);
    /// <summary>
    /// Splits prose into text and link segments. A link's Text is its host and trimmed path (about 60 characters) and its Url the full
    /// address; plain segments carry a null Url. Only absolute http(s) addresses become links; everything else stays literal text.
    /// </summary>
    private static IEnumerable<(string Text, string? Url)> Segments(string text)
    {
        var position = 0;
        foreach (System.Text.RegularExpressions.Match match in LinkPattern.Matches(text))
        {
            if (match.Index < position) continue;
            var candidate = TrimLink(match.Value);
            if (!Uri.TryCreate(candidate, UriKind.Absolute, out var uri) || uri.Scheme is not ("http" or "https") || string.IsNullOrEmpty(uri.Host)) continue;
            if (match.Index > position) yield return (text[position..match.Index], null);
            yield return (LinkLabel(candidate, uri), candidate);
            position = match.Index + candidate.Length;
        }
        if (position < text.Length) yield return (text[position..], null);
    }
    /// <summary>Drops sentence punctuation that follows a link, and a closing bracket the link never opened.</summary>
    private static string TrimLink(string candidate)
    {
        while (candidate.Length > 0)
        {
            var last = candidate[^1];
            if (last is '.' or ',' or ';' or ':' or '!' or '?' or '\'' or '"') candidate = candidate[..^1];
            else if (last is ')' && candidate.Count(c => c == ')') > candidate.Count(c => c == '(')) candidate = candidate[..^1];
            else if (last is ']' && candidate.Count(c => c == ']') > candidate.Count(c => c == '[')) candidate = candidate[..^1];
            else break;
        }
        return candidate;
    }
    private static string LinkLabel(string url, Uri uri)
    {
        var label = Host(url) + uri.AbsolutePath.TrimEnd('/');
        return label.Length > 60 ? label[..59] + "…" : label;
    }

    // ---- goal history storage -----------------------------------------------

    private GoalStoreInventoryReport? _goalStorage;
    private string? _goalStorageError;
    private IReadOnlyList<GoalCompactionRun> _compactionJournal = [];
    private bool _compacting;

    private string CompactionStatus
    {
        get
        {
            if (GoalReceiptCompaction.LastReport is { } report)
            {
                var when = AppNavigation.RelativeTime(report.StartedUtc.UtcDateTime);
                if (report.Error is not null) return $"Last run {when} couldn't finish ({report.Error}). Nothing was lost; it tries again when idle.";
                return report.GoalsChanged == 0
                    ? $"Last check {when}: nothing old enough to trim ({report.Goals.Count} goal{(report.Goals.Count == 1 ? "" : "s")}, {report.GoalsHeld} still working)."
                    : $"Last run {when}: {Trimmed(report.ReceiptsCompacted, report.BytesCompacted)}, {GoalReceiptCompaction.Size(report.LogBytesReleased)} freed.";
            }
            if (_compactionJournal.Count > 0)
            {
                var last = _compactionJournal[^1];
                var when = AppNavigation.RelativeTime(last.AtUtc.UtcDateTime);
                return last.Receipts == 0
                    ? $"Last run {when}: {GoalReceiptCompaction.Size(Math.Max(0, last.LogBytesBefore - last.LogBytesAfter))} freed."
                    : $"Last run {when}: {Trimmed(last.Receipts, last.BytesCompacted)}, {GoalReceiptCompaction.Size(Math.Max(0, last.LogBytesBefore - last.LogBytesAfter))} freed.";
            }
            return Prefs.CompactGoalReceipts ? "Runs while Talavine Code is idle; nothing has been trimmed yet." : "Off: every record keeps its full output.";
        }
    }

    private static string Trimmed(int receipts, long bytes)
        => $"{receipts} output{(receipts == 1 ? "" : "s")} trimmed ({GoalReceiptCompaction.Size(bytes)})";

    private static string StrayLabel(GoalStoreInventoryReport storage, GoalStoreFile file)
    {
        var relative = Path.GetRelativePath(storage.Directory, file.Path);
        return Directory.Exists(file.Path) ? relative + " (folder)" : relative;
    }

    private Task OpenGoalsFolder() => FolderLauncher.OpenAsync(Path.Combine(State.Paths.RootDirectory, "goals"));

    private async Task LoadGoalStorageAsync()
    {
        try
        {
            var goals = State.Goals;
            var (storage, journal) = await Task.Run(async () => (goals.Inspect(), await goals.GetCompactionJournalAsync()));
            _goalStorage = storage;
            _compactionJournal = journal;
            _goalStorageError = null;
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or InvalidDataException or System.Text.Json.JsonException)
        {
            _goalStorage = null;
            _goalStorageError = ex.Message;
        }
    }

    private async Task CompactNowAsync()
    {
        if (_compacting) return;
        _compacting = true;
        try
        {
            var services = State.Workspace?.Services;
            var service = services?.GetService<GoalReceiptCompaction>()
                ?? new GoalReceiptCompaction(State.Goals, State.Preferences, services?.GetService<GoalReceiptCompactionOptions>() ?? new GoalReceiptCompactionOptions());
            var report = await Task.Run(() => service.RunOnceAsync(manual: true));
            if (report is null) Show("Trimming is already running.", false);
            else if (report.Error is not null) Show("Trimming couldn't finish: " + report.Error, true);
            await LoadGoalStorageAsync();
        }
        catch (Exception ex) { Show("Trimming couldn't finish: " + ex.Message, true); }
        finally { _compacting = false; }
    }

    private void Show(string text, bool isError) { _message = text; _messageIsError = isError; }

    // ---- self-improvement -----------------------------------------------------

    private SwarmCore.Coding.SelfImprovement.SelfImprovementOptions _selfImprovement = new();
    private int _selfImprovementIdleMinutes = 10;
    private string? _selfImprovementDetected;

    private void LoadSelfImprovement()
    {
        _selfImprovement = SettingsFile.ReadCodingSection<SwarmCore.Coding.SelfImprovement.SelfImprovementOptions>("SelfImprovement");
        _selfImprovementIdleMinutes = Math.Max(1, (int)Math.Round(_selfImprovement.UserIdleAfter.TotalMinutes));
        _selfImprovementDetected = SwarmCode.Hosting.Improvement.SwarmCodeSourceRepository.Detect(AppContext.BaseDirectory);
    }

    private async Task SaveSelfImprovementAsync()
    {
        if (_selfImprovementIdleMinutes is < 1 or > 720) { Show("Quiet minutes must be between 1 and 720.", true); return; }
        if (_selfImprovement.MaxAttemptsPerItem is < 1 or > 10) { Show("Attempts per item must be between 1 and 10.", true); return; }
        if (_selfImprovement.RepositoryRoot is { } root && !Directory.Exists(root)) { Show("The source repository folder does not exist.", true); return; }
        if (_selfImprovement.RepositoryRoot is { } configured && !SwarmCode.Hosting.Improvement.SwarmCodeSourceRepository.IsSwarmCodeRepository(configured))
        { Show("That folder is not a Talavine Code checkout (SwarmCode.Hosting and SwarmCore/SwarmCore.Coding were not found in it).", true); return; }
        _busy = true;
        try
        {
            _selfImprovement.UserIdleAfter = TimeSpan.FromMinutes(_selfImprovementIdleMinutes);
            _selfImprovement.Lane = string.IsNullOrWhiteSpace(_selfImprovement.Lane) ? null : _selfImprovement.Lane.Trim();
            var saved = _selfImprovement;
            await Task.Run(() => SettingsFile.WriteCodingSection("SelfImprovement", saved));
            State.SelfImprovement?.Wake();
            var ok = State.Workspace is null || await State.ReloadWorkspaceAsync();
            Show(ok ? "Self-improvement settings saved." : "Settings saved, but the repository failed to reload.", !ok);
        }
        catch (Exception ex) { Show("Could not save self-improvement settings: " + ex.Message, true); }
        finally { _busy = false; }
    }


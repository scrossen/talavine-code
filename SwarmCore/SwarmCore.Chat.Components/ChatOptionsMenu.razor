@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="@Class" @ref="_root">
    <button type="button" class="chat-composer-surface__icon" popovertarget="@_id"
            aria-label="Chat options" title="Model and chat options"
            aria-haspopup="dialog" data-testid="chat-options-trigger">⋯</button>
    <div id="@_id" class="@MenuClass" popover="auto" role="dialog" aria-label="Chat options"
         data-testid="chat-options-menu" @onkeydown:stopPropagation>
        @ChildContent
    </div>
</div>

@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? MenuClass { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private readonly string _id = "chat-options-" + Guid.NewGuid().ToString("N");
    private ElementReference _root;
    private IJSObjectReference? _module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        // The shared composer popover positions above its trigger, follows zoom,
        // and restores native Escape/light-dismiss behavior without clipping.
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/SwarmCore.Chat.Components/composerModelPicker.js");
        await _module.InvokeVoidAsync("initialize", _root);
    }

    public async Task CloseAsync()
    {
        if (_module is not null) await _module.InvokeVoidAsync("close", _root);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is null) return;
        try { await _module.InvokeVoidAsync("dispose", _root); await _module.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}

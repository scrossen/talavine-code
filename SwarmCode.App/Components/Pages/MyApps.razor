@page "/apps"
@page "/apps/{AppId}"
@implements IDisposable
@using System.Text.Json
@using SwarmCore.Coding.Projects
@inject MyAppsService Apps
@inject IFolderPickerService Picker
@inject NavigationManager Nav
@inject IdeIntegration Ide

<PageTitle>My apps - Talavine Code</PageTitle>

<div class="sc-page sc-apps" data-testid="my-apps">
    <header class="sc-topbar">
        <div>
            <h1 class="sc-topbar__title">My apps</h1>
            <p class="sc-topbar__copy">Build, run, and return to your apps. Work on any app in chat.</p>
        </div>
        <div class="sc-topbar__actions">
            <button type="button" class="sc-btn" @onclick="AddAsync">Add an app…</button>
            <button type="button" class="sc-btn sc-btn--primary" @onclick="ShowCreate">Create an app</button>
        </div>
    </header>

    @if (_error is not null)
    {
        <div class="sc-notice sc-notice--error sc-apps__notice" role="alert">@_error</div>
    }
    @if (_busy)
    {
        <p class="sc-muted" role="status"><span class="sc-spinner"></span> @_progress</p>
    }
    @if (_library is null)
    {
        @if (_loadFailed) { <button type="button" class="sc-btn" @onclick="LoadAsync">Reload app library</button> }
        else { <p class="sc-muted">Loading your apps…</p> }
    }
    else
    {
        <section class="sc-card sc-apps__folder">
            <div class="sc-grow">
                <h2 class="sc-card__title">@(_library.AppsFolder is null ? "Choose a home for your apps" : "Your apps folder")</h2>
                <p class="sc-card__copy">@(_library.AppsFolder is null ? "Choose where Talavine Code will create new apps. You can also add existing projects from other folders." : "New apps go here. Changing this folder keeps your existing apps in their current locations.")</p>
                @if (_library.AppsFolder is not null) { <div class="sc-muted sc-mono sc-apps__path">@_library.AppsFolder</div> }
            </div>
            <button type="button" class="sc-btn" @onclick="ChooseFolderAsync">@(_library.AppsFolder is null ? "Choose apps folder…" : "Change folder…")</button>
        </section>

        @if (_create)
        {
            <section class="sc-card sc-apps__form" aria-label="Create an app">
                <h2 class="sc-card__title">What would you like to build?</h2>
                <label class="sc-field"><span class="sc-field__label">App name</span><input class="sc-input" @bind="_name" placeholder="Garden planner" maxlength="80" /></label>
                <label class="sc-field"><span class="sc-field__label">Describe your app</span><textarea class="sc-textarea" rows="4" @bind="_description" placeholder="An app to plan my garden, track planting dates, and see what to harvest next." /></label>
                <BuildModelPicker SelectionChanged="choice => _buildSelection = choice" />
                <p class="sc-muted">Talavine Code creates a project folder, opens its chat, and starts building. You can keep refining it there.</p>
                <div class="sc-row">
                    <button type="button" class="sc-btn sc-btn--primary" @onclick="CreateAsync">Build in chat</button>
                    <button type="button" class="sc-btn" @onclick="() => _create = false">Cancel</button>
                </div>
            </section>
        }

        @if (_selected is { } selected)
        {
            var status = Apps.Runtime.Status(selected.Id);
            <section class="sc-card sc-apps__detail">
                <a href="/apps">← All apps</a>
                <div class="sc-row sc-row--between">
                    <div><h2 class="sc-card__title">@selected.Name</h2><p class="sc-card__copy">@selected.Description</p></div>
                    <span class="sc-chip @(status.State == CodingAppRunState.Running ? "sc-chip--accent" : "")">@status.State</span>
                </div>
                <div class="sc-muted sc-mono sc-apps__path">@selected.Root</div>
                <p role="status">@status.Message @if (status.Replayed) { <span class="sc-muted">· Saved launch steps</span> }</p>
                <div class="sc-row sc-apps__actions">
                    <button type="button" class="sc-btn sc-btn--primary" @onclick="() => WorkAsync(selected.Id)">Work on this app</button>
                    <button type="button" class="sc-btn" @onclick="() => RunAsync(selected.Id)">Run app</button>
                    @if (Apps.Runtime.IsBusy(selected.Id)) { <button type="button" class="sc-btn" @onclick="() => StopAsync(selected.Id)">Stop app</button> }
                    @if (status.Url is { } url) { <button type="button" class="sc-btn" @onclick="() => OpenPreviewAsync(url)">Open app ↗</button> }
                    <button type="button" class="sc-btn" @onclick="() => SetupAsync(selected.Id)">Set up Run app</button>
                    <button type="button" class="sc-btn" @onclick="() => WorkAsync(selected.Id, true)">New chat</button>
                </div>
                <details class="sc-apps__files" @ontoggle="FilesToggled">
                    <summary>Files</summary>
                    <p class="sc-muted">Browse the actual project files. Source folders stay on your computer.</p>
                    <div class="sc-row">
                        <button type="button" class="sc-btn sc-btn--sm" @onclick='() => LoadFilesAsync(".")'>Project folder</button>
                        @if (_directory != ".") { <button type="button" class="sc-btn sc-btn--sm" @onclick="UpAsync">Up one folder</button> }
                        <span class="sc-muted sc-mono">@_directory</span>
                        <button type="button" class="sc-btn sc-btn--sm" @onclick="() => OpenEditorAsync(selected.Root)">@Ide.OpenLabel</button>
                    </div>
                    <div class="sc-apps__file-layout">
                        <nav class="sc-apps__file-list" aria-label="Project files">
                            @foreach (var file in _files.Take(500))
                            {
                                <button type="button" class="sc-apps__file @(file.RelativePath == _file ? "sc-apps__file--active" : "")" @onclick="() => FileAsync(file)">@(file.IsDirectory ? "▸ " : "")@file.Name</button>
                            }
                            @if (_files.Count > 500) { <p class="sc-muted">Showing 500 entries. Open your editor to see more.</p> }
                        </nav>
                        <div class="sc-apps__file-preview">
                            @if (_file is not null)
                            {
                                <div class="sc-row sc-row--between"><strong class="sc-mono">@_file</strong><button type="button" class="sc-btn sc-btn--sm" @onclick="() => OpenEditorAsync(CodingAppPaths.Within(selected.Root, _file))">Open in editor</button></div>
                                <pre>@_fileText</pre>
                            }
                            else { <p class="sc-muted">Choose a file to preview its contents.</p> }
                        </div>
                    </div>
                </details>
                <details class="sc-apps__manage">
                    <summary>Manage app</summary>
                    <p class="sc-muted">Remove the library entry and stop its running app. Your project files and chat history are kept.</p>
                    <button type="button" class="sc-btn sc-btn--danger" @onclick="() => RemoveAsync(selected.Id)">Remove from My apps</button>
                </details>
            </section>
        }
        else
        {
            <label class="sc-field"><span class="sc-field__label">Find an app</span><input class="sc-input" type="search" @bind="_search" @bind:event="oninput" placeholder="Search your apps" /></label>
            @if (_library.Apps.Count == 0)
            {
                <section class="sc-card sc-empty"><h2 class="sc-empty__title">Your next idea starts here</h2><p>Create an app from a description, or add a project you already have.</p></section>
            }
            else if (!FilteredApps.Any()) { <p class="sc-muted">No apps match this search.</p> }
            <div class="sc-apps__grid">
                @foreach (var app in FilteredApps)
                {
                    var status = Apps.Runtime.Status(app.Id);
                    <article class="sc-card sc-apps__tile">
                        <div class="sc-row sc-row--between"><a class="sc-apps__name" href="@AppUrl(app.Id)">@app.Name</a><span class="sc-chip">@(_available.Contains(app.Id) ? status.State : "Folder missing")</span></div>
                        <p class="sc-card__copy sc-grow">@app.Description</p>
                        <div class="sc-muted sc-mono sc-apps__path">@app.Root</div>
                        @if (status.State is CodingAppRunState.Starting or CodingAppRunState.Failed) { <p role="status">@status.Message</p> }
                        <div class="sc-row sc-apps__actions">
                            <button type="button" class="sc-btn sc-btn--primary" @onclick="() => WorkAsync(app.Id)">Work on this app</button>
                            <button type="button" class="sc-btn" @onclick="() => RunAsync(app.Id)">Run app</button>
                            @if (Apps.Runtime.IsBusy(app.Id)) { <button type="button" class="sc-btn sc-btn--sm" @onclick="() => StopAsync(app.Id)">Stop</button> }
                            <a class="sc-btn sc-btn--sm" href="@AppUrl(app.Id)">Files &amp; details</a>
                        </div>
                    </article>
                }
            </div>
        }
    }

    @if (_approval is { } approval)
    {
        <div class="sc-apps__approval" role="dialog" aria-modal="true" aria-label="Allow app launch">
            <section class="sc-card sc-apps__approval-card">
                <h2 class="sc-card__title">Run @approval.Name?</h2>
                <p>Your permission settings ask before running programs. This launch runs code from the app folder.</p>
                <pre>@_approvalPlan</pre>
                <div class="sc-row"><button type="button" class="sc-btn sc-btn--primary" @onclick="ApproveRunAsync">Allow this launch</button><button type="button" class="sc-btn" @onclick="() => _approval = null">Cancel</button></div>
            </section>
        </div>
    }
</div>

@code {
    [Parameter] public string? AppId { get; set; }
    private CodingAppLibrary? _library;
    private CodingModelChoice? _buildSelection;
    private CodingAppProject? _selected;
    private CodingAppProject? _approval;
    private string? _approvalPlan;
    private bool _create, _busy, _disposed, _loadFailed;
    private HashSet<string> _available = [];
    private string _progress = "", _name = "", _description = "", _search = "", _directory = ".";
    private string? _error, _file, _fileText;
    private IReadOnlyList<CodingAppFile> _files = [];
    private IEnumerable<CodingAppProject> FilteredApps => (_library?.Apps ?? []).Where(a => string.IsNullOrWhiteSpace(_search)
        || a.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) || a.Description.Contains(_search, StringComparison.OrdinalIgnoreCase)).OrderBy(a => a.Name, StringComparer.OrdinalIgnoreCase);
    private static string AppUrl(string id) => "/apps/" + Uri.EscapeDataString(id);
    protected override void OnInitialized() => Apps.Runtime.Changed += OnRuntimeChanged;
    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
        _selected = _library?.Apps.FirstOrDefault(a => a.Id == AppId);
        if (AppId is not null && _selected is null) _error = "This app is no longer in your library.";
        _directory = "."; _files = []; _file = null; _fileText = null;
        if (_selected is not null) await LoadFilesAsync(".");
    }
    private void OnRuntimeChanged() => _ = InvokeAsync(() => { if (!_disposed) StateHasChanged(); });
    private async Task LoadAsync()
    {
        try
        {
            var loaded = await Task.Run(() => { var library = Apps.Library.Read(); return (Library: library, Available: library.Apps.Where(a => Directory.Exists(a.Root)).Select(a => a.Id).ToHashSet()); });
            _library = loaded.Library; _available = loaded.Available; _loadFailed = false;
        }
        catch (Exception ex) { _loadFailed = true; _error = "Your app library could not be read. Your project files have been kept. " + ex.Message; }
    }
    private async Task PerformAsync(string progress, Func<Task> action)
    {
        if (_busy) return;
        _busy = true; _error = null; _progress = progress;
        try { await action(); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; if (!_disposed) { await LoadAsync(); StateHasChanged(); } }
    }
    private void ShowCreate() { if (!_create) _buildSelection = null; _create = true; _error = null; }
    private Task ChooseFolderAsync() => PerformAsync("Choosing your apps folder…", async () =>
    {
        var expected = _library?.AppsFolder;
        var chosen = await Picker.PickFolderAsync(new("Choose your apps folder", expected));
        if (chosen is not null) await Task.Run(() => Apps.Library.SetFolder(chosen, expected));
    });
    private Task AddAsync() => PerformAsync("Adding your app…", async () =>
    {
        var chosen = await Picker.PickFolderAsync(new("Add an existing app", _library?.AppsFolder));
        if (chosen is null) return;
        var app = await Task.Run(() => Apps.Library.Add(chosen));
        Nav.NavigateTo(AppUrl(app.Id));
    });
    private Task CreateAsync() => PerformAsync("Creating your project and opening chat…", async () =>
    {
        if (_library?.AppsFolder is not { } folder) throw new InvalidOperationException("Choose your apps folder first. Your description has been kept.");
        var session = await Apps.CreateAsync(_name, _description, folder, _buildSelection);
        Nav.NavigateTo(AppNavigation.SessionUrl(session.Id));
    });
    private Task WorkAsync(string id, bool newChat = false) => PerformAsync("Opening your app's chat…", async () =>
    {
        var session = await Apps.WorkAsync(id, newSession: newChat);
        Nav.NavigateTo(AppNavigation.SessionUrl(session.Id));
    });
    private Task SetupAsync(string id) => PerformAsync("Opening launch setup in chat…", async () =>
    {
        var session = await Apps.WorkAsync(id, CodingAppPrompts.SetupRun, newSession: true);
        Nav.NavigateTo(AppNavigation.SessionUrl(session.Id));
    });
    private Task RunAsync(string id) => PerformAsync("Starting your app…", async () =>
    {
        var app = await Task.Run(() => Apps.Library.Get(id));
        CodingAppLaunchPlan? plan;
        try { plan = await Task.Run(() => CodingAppLaunchFile.Read(app.Root)); }
        catch (Exception ex) when (ex is JsonException or InvalidDataException) { plan = null; }
        if (plan is null)
        {
            var session = await Apps.WorkAsync(id, CodingAppPrompts.SetupRun, newSession: true);
            Nav.NavigateTo(AppNavigation.SessionUrl(session.Id));
            return;
        }
        var permission = await Task.Run(Apps.RunPermission);
        if (permission.Verdict == CodingPermissionVerdict.Ask)
        { _approval = app; _approvalPlan = JsonSerializer.Serialize(plan, CodingAppLaunchFile.Json); return; }
        await Apps.RunAsync(id);
    });
    private Task ApproveRunAsync() => PerformAsync("Starting your app…", async () =>
    {
        var app = _approval ?? throw new InvalidOperationException("Choose an app first.");
        var reviewed = _approvalPlan;
        _approval = null;
        await Apps.RunAsync(app.Id, reviewed);
    });
    private async Task StopAsync(string id)
    {
        try { await Apps.Runtime.StopAsync(id); }
        catch (Exception ex) { _error = ex.Message; }
    }
    private Task OpenPreviewAsync(string url) => PerformAsync("Opening your app…", () => MyAppsService.OpenPreviewAsync(url));
    private Task RemoveAsync(string id) => PerformAsync("Removing the library entry…", async () => { await Apps.RemoveAsync(id); Nav.NavigateTo("/apps"); });
    private async Task FilesToggled(EventArgs _) { if (_files.Count == 0 && _selected is not null) await LoadFilesAsync("."); }
    private async Task LoadFilesAsync(string relative)
    {
        try { if (_selected is not { } selected) return; var files = await Task.Run(() => CodingAppFiles.List(selected.Root, relative)); if (_selected?.Id != selected.Id || _disposed) return; _files = files; _directory = relative; _file = null; _fileText = null; }
        catch (Exception ex) { _error = ex.Message; }
    }
    private Task UpAsync() => LoadFilesAsync(Path.GetDirectoryName(_directory) is { Length: > 0 } parent ? parent : ".");
    private async Task FileAsync(CodingAppFile file)
    {
        if (_selected is not { } selected) return;
        if (file.IsDirectory) { await LoadFilesAsync(file.RelativePath); return; }
        try { var text = await Task.Run(() => CodingAppFiles.Read(selected.Root, file.RelativePath)); if (_selected?.Id != selected.Id || _disposed) return; _fileText = text; _file = file.RelativePath; }
        catch (Exception ex) { _error = ex.Message; }
    }
    private async Task OpenEditorAsync(string path) { if (_selected is not null) await Ide.OpenAsync(new(path), _selected.Root); }
    public void Dispose() { _disposed = true; Apps.Runtime.Changed -= OnRuntimeChanged; }
}

        var draft = System.Text.Json.JsonSerializer.Deserialize<CodingComputerOptions>(System.Text.Json.JsonSerializer.Serialize(_computer))!;
        if (!string.IsNullOrWhiteSpace(draft.ChromeCdpEndpoint) && (!Uri.TryCreate(draft.ChromeCdpEndpoint, UriKind.Absolute, out var endpoint) || !endpoint.IsLoopback || endpoint.Scheme is not ("http" or "https" or "ws" or "wss"))) { Show("The Chrome connection must be a loopback address.", true); return; }
        _busy = true;
        try
        {
            await Task.Run(() => SettingsFile.WriteCodingSection("Computer", draft));
            var ok = State.Workspace is null || await State.ReloadWorkspaceAsync();
            Show(ok ? "Computer settings saved." : "Saved, but the repository failed to reload.", !ok);
        }
        catch (Exception ex) { Show("Could not save computer settings: " + ex.Message, true); }
        finally { _busy = false; }

    private async Task SaveRuntimeAsync()
    {
        if (State.AnyTurnRunning) { Show("Stop active work before changing runtime settings.", true); return; }
        if (_limitMinutes < 0 || _limitTools < 0 || _limitTokens < 0 || _repairAttempts is < 0 or > 10) { Show("Limits must be zero or positive; repair attempts must be between zero and ten.", true); return; }
        if (_checks.Any(c => string.IsNullOrWhiteSpace(c.Name) || string.IsNullOrWhiteSpace(c.FileName))) { Show("Every verification check needs a name and an executable.", true); return; }
        _busy = true;
        try
        {
            var limits = new CodingExecutionLimits { Timeout = _limitMinutes == 0 ? Timeout.InfiniteTimeSpan : TimeSpan.FromMinutes(_limitMinutes), MaxToolCalls = _limitTools, MaxCumulativeTokens = _limitTokens, MaxIterations = _limitIterations };
            var acceptance = new CodingAcceptanceOptions { MaxRepairAttempts = _repairAttempts, Commands = _checks.Select(c => new CodingAcceptanceCommand { Name = c.Name.Trim(), FileName = c.FileName.Trim(), Arguments = c.Arguments.Replace("\r", "").Split('\n', StringSplitOptions.RemoveEmptyEntries).ToList(), RequiredOutput = string.IsNullOrEmpty(c.RequiredOutput) ? null : c.RequiredOutput, WorkingDirectory = c.WorkingDirectory, TimeoutSeconds = c.TimeoutSeconds, ExpectedExitCode = c.ExpectedExitCode }).ToList() };
            await Task.Run(() => SettingsFile.WriteWorkSettings(limits, acceptance));
            var ok = State.Workspace is null || await State.ReloadWorkspaceAsync();
            Show(ok ? "Work settings saved." : "Settings saved, but the repository failed to reload.", !ok);
        }
        catch (Exception ex) { Show("Could not save runtime settings: " + ex.Message, true); }
        finally { _busy = false; }
    }

    private List<SwarmCode.Hosting.Mcp.ExternalMcpServer> _mcpServers = [];
    private List<string> _mcpProblems = [];
    private string _mcpTransport = "stdio";
    private bool _mcpHttp => string.Equals(_mcpTransport, "http", StringComparison.Ordinal);
    private string _mcpUrl = "";
    private string _mcpBearer = "";
    private string _mcpName = "";
    private string _mcpCommand = "";
    private string _mcpArguments = "";
    private string _mcpEnvironment = "";
    private bool _mcpTrusted;
    private bool _mcpRequired;

    private SwarmCode.Hosting.Mcp.ExternalMcpServersFile McpFile => new(State.Paths);

    private async Task RefreshMcpServersAsync()
    {
        var snapshot = await Task.Run(() => McpFile.Read());
        _mcpServers = [.. snapshot.Servers];
        _mcpProblems = [.. snapshot.Problems];
    }

    private async Task SaveMcpServerAsync()
    {
        if (State.AnyTurnRunning) { Show("Stop active work before changing MCP servers.", true); return; }
        var name = _mcpName.Trim();
        var useHttp = _mcpHttp;
        var url = _mcpUrl.Trim();
        var bearer = string.IsNullOrWhiteSpace(_mcpBearer) ? null : _mcpBearer.Trim();
        if (!SwarmCode.Hosting.Mcp.ExternalMcpServersFile.IsValidName(name)) { Show("Give the server a name made of letters, digits, '_' and '-'.", true); return; }
        if (!_mcpHttp && string.IsNullOrWhiteSpace(_mcpCommand)) { Show("Enter the command that starts the server.", true); return; }
        var environment = new List<KeyValuePair<string, string>>();
        foreach (var line in (_mcpHttp ? "" : _mcpEnvironment).Replace("\r", "").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            var equals = line.IndexOf('=');
            if (equals <= 0) { Show($"Environment lines must look like NAME=value (\"{line}\").", true); return; }
            environment.Add(new(line[..equals].Trim(), line[(equals + 1)..]));
        }
        var arguments = _mcpArguments.Replace("\r", "").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        _busy = true;
        try
        {
            var launch = _mcpHttp ? null : new SwarmCore.Mcp.ExternalClients.McpServerLaunchEntry(_mcpCommand.Trim(), arguments, environment);
            var (trusted, required) = (_mcpTrusted, _mcpRequired);
            var problem = await Task.Run(() => useHttp
                ? McpFile.UpsertHttp(name, url, bearer, trusted, required)
                : McpFile.Upsert(name, launch!, trusted, required));
            if (problem is not null) { Show("Could not save the server: " + problem, true); return; }
            _mcpName = _mcpCommand = _mcpArguments = _mcpEnvironment = _mcpUrl = _mcpBearer = "";
            _mcpTrusted = _mcpRequired = false;
            await RefreshMcpServersAsync();
            var ok = State.Workspace is null || await State.ReloadWorkspaceAsync();
            Show(ok ? $"Saved {name}. New sessions and turns can use its tools." : $"Saved {name}, but the repository failed to reload.", !ok);
        }
        catch (Exception ex) { Show("Could not save the server: " + ex.Message, true); }
        finally { _busy = false; }
    }

    private async Task RemoveMcpServerAsync(string name)
    {
        if (State.AnyTurnRunning) { Show("Stop active work before changing MCP servers.", true); return; }
        _busy = true;
        try
        {
            var problem = await Task.Run(() => McpFile.Remove(name));
            if (problem is not null) { Show("Could not remove the server: " + problem, true); return; }
            await RefreshMcpServersAsync();
            var ok = State.Workspace is null || await State.ReloadWorkspaceAsync();
            Show(ok ? $"Removed {name}." : $"Removed {name}, but the repository failed to reload.", !ok);
        }
        catch (Exception ex) { Show("Could not remove the server: " + ex.Message, true); }
        finally { _busy = false; }
    }


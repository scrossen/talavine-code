@namespace SwarmCode.App.Components.Chat
@using SwarmCore.Agent.Communication
@using SwarmCore.Chat.Components
@using SwarmCore.Coding.Goals
@implements IDisposable

<section class="sc-goals" aria-label="Agent inbox">
    @if (_error is not null) { <div class="sc-notice sc-notice--error" role="alert">@_error</div> }
    <div class="sc-goals__columns">
        <nav class="sc-goals__contacts" aria-label="Named agents">
            @if (_loading) { <p class="sc-muted" role="status">Loading agents…</p> }
            @if (!_loading && _contacts.Count == 0) { <p class="sc-muted">Start ongoing work with /goal in a chat. Its agent will appear here.</p> }
            @foreach (var contact in _contacts)
            {
                <button type="button" class="sc-goals__contact @(contact.GoalId == _selected ? "sc-goals__contact--active" : "")"
                        aria-pressed="@(contact.GoalId == _selected ? "true" : "false")" @onclick="() => SelectAsync(contact.GoalId)">
                    <strong>@contact.Name</strong><span>@("@" + contact.Handle)</span><span class="sc-muted">@contact.Status</span>
                </button>
            }
        </nav>
        <div class="sc-goals__thread">
            @if (_contact is not { } selected)
            {
                <div class="sc-empty"><div class="sc-empty__title">Choose an agent</div><p>Send an idea or question without interrupting its work.</p></div>
            }
            else
            {
                var items = Items().ToArray();
                <header class="sc-goals__header">
                    <div><h2>@selected.Name</h2><span class="sc-muted">@("@" + selected.Handle) · @selected.Status</span></div>
                    <div class="sc-row"><a class="sc-btn" href="@SwarmCode.App.Services.AppNavigation.SessionUrl(selected.ConversationId)">Open work</a>
                    <button type="button" class="sc-btn" @onclick="BeginRename">Rename agent</button></div>
                </header>
                @if (_renaming)
                {
                    <div class="sc-card sc-goals__rename">
                        <label class="sc-field">Name<input class="sc-input" aria-label="Agent name" maxlength="100" @bind="_name" /></label>
                        <label class="sc-field">Handle<input class="sc-input" aria-label="Agent handle" maxlength="40" @bind="_handle" /></label>
                        <p class="sc-muted">Use a letter, then lowercase letters, numbers, - or _. Renaming keeps the same agent and work.</p>
                        <div class="sc-row"><button type="button" class="sc-btn sc-btn--primary" @onclick="RenameAsync">Save name</button>
                        <button type="button" class="sc-btn" @onclick="() => _renaming = false">Cancel</button></div>
                        @if (_renameError is not null) { <p class="sc-notice sc-notice--error" role="alert">@_renameError</p> }
                    </div>
                }
                @if (Ledger is not null || Results is not null || Reports is not null)
                {
                    <div class="sc-goals__views" role="group" aria-label="Agent views">
                        <button type="button" class="sc-goals__view @(_view == PanelView.Messages ? "sc-goals__view--active" : "")"
                                aria-pressed="@(_view == PanelView.Messages ? "true" : "false")" @onclick="() => ShowAsync(PanelView.Messages)">Messages</button>
                        @if (Reports is not null)
                        {
                            <button type="button" class="sc-goals__view @(_view == PanelView.Reports ? "sc-goals__view--active" : "")"
                                    aria-pressed="@(_view == PanelView.Reports ? "true" : "false")" @onclick="() => ShowAsync(PanelView.Reports)">Daily reports</button>
                        }
                        @if (Results is not null)
                        {
                            <button type="button" class="sc-goals__view @(_view == PanelView.Results ? "sc-goals__view--active" : "")"
                                    aria-pressed="@(_view == PanelView.Results ? "true" : "false")" @onclick="() => ShowAsync(PanelView.Results)">What's been done</button>
                        }
                        @if (Ledger is not null)
                        {
                            <button type="button" class="sc-goals__view @(_view == PanelView.Ledger ? "sc-goals__view--active" : "")"
                                    aria-pressed="@(_view == PanelView.Ledger ? "true" : "false")" @onclick="() => ShowAsync(PanelView.Ledger)">@(Results is null ? "What's been done" : "All activity")</button>
                        }
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(selected.StatusDetail))
                {
                    <p class="sc-notice" role="status">@selected.StatusDetail</p>
                }
                @if (!string.IsNullOrWhiteSpace(selected.Blocker)) { <p class="sc-muted">Last recorded blocker: @selected.Blocker</p> }
                @if (_view == PanelView.Messages)
                {
                <p class="sc-muted">Received means saved; Delivered means handed to the worker. Read and Incorporated require its acknowledgment. Status notices explain held work; only Resume restarts paused work.</p>
                <div class="sc-goals__scroll">
                    <ChatScrollRegion ConversationKey="@selected.GoalId.ToString()" JumpLabel="@(_hasMore ? "Jump to latest loaded" : "Jump to latest")" ContentRevision="@((items.Length, items.Select(i => i.Sequence).DefaultIfEmpty().Max()))">
                        <div class="sc-goals__messages" role="list" aria-label="Messages and replies" aria-live="polite">
                            @foreach (var item in items)
                            {
                                <article class="sc-goals__message @(item.Reply ? "sc-goals__message--reply" : "")" role="listitem" @key="item.Id">
                                    <div class="sc-goals__message-meta"><strong>@item.Label</strong><span class="sc-chip">@item.State</span><time>@item.At.ToLocalTime().ToString("g")</time></div>
                                    <p>@item.Text</p>
                                    @foreach (var file in item.Attachments)
                                    {
                                        <p class="sc-muted sc-goals__attachment">Attached file: @file.FileName · @file.MediaType · @file.Length bytes (local to Code)</p>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(item.Detail)) { <p class="sc-muted">@item.Detail</p> }
                                </article>
                            }
                        </div>
                    </ChatScrollRegion>
                </div>
                @if (_messages.Count == 0 && _replies.Count == 0) { <p class="sc-muted">No messages yet.</p> }
                @if (_hasMore) { <div class="sc-row"><span class="sc-muted">Showing latest loaded messages.</span><button type="button" class="sc-btn" @onclick="LoadMoreAsync">Load more messages</button></div> }
                @if (Draft is { } draft)
                {
                    <div class="sc-goals__composer">
                        @if (selected.IsClosed) { <p class="sc-muted" role="status">This goal is closed. Its messages and replies remain available. Start another goal in a chat to continue.</p> }
                        <label class="sc-field">Message to @("@" + selected.Handle)
                            <textarea class="sc-textarea" aria-label="Message to agent" rows="4" maxlength="8000" disabled="@selected.IsClosed" @bind="draft.Text" @bind:event="oninput"></textarea>
                        </label>
                        <div class="sc-row">
                            <select class="sc-select sc-goals__kind" aria-label="Message kind" disabled="@selected.IsClosed" @bind="draft.Kind">
                                @foreach (var kind in Enum.GetValues<GoalMessageKind>()) { <option value="@kind">@kind</option> }
                            </select>
                            <button type="button" class="sc-btn sc-btn--primary" disabled="@(selected.IsClosed || draft.IsSending)" @onclick="SendAsync">@(draft.IsSending ? "Saving…" : "Send to agent inbox")</button>
                            <button type="button" class="sc-btn" @onclick="RefreshAsync">Refresh</button>
                        </div>
                        @if (draft.Error is not null) { <p class="sc-notice sc-notice--error" role="alert">@draft.Error</p> }
                        @if (draft.Pending is not null)
                        {
                            <div class="sc-goals__pending"><span class="sc-muted">Pending message: @draft.Pending.Text</span>
                            <button type="button" class="sc-btn" @onclick="RetryAsync">Retry same message</button></div>
                        }
                        @if (draft.Saved is { } saved) { <p class="sc-muted" role="status">Message saved · @saved.State</p> }
                    </div>
                }
                }
                else if (_view == PanelView.Reports)
                {
                    <p class="sc-muted">What the agent achieved toward the goal each day, newest first, and anything you asked for that it held or could not do.</p>
                    <div class="sc-row sc-goals__ledger-controls">
                        <button type="button" class="sc-btn" @onclick="() => RefreshReportsAsync(reset: false)">Refresh</button>
                        @if (_reportsLoading) { <span class="sc-spinner" aria-hidden="true"></span> }
                        @if (_reports is { } reportCounts) { <span class="sc-muted">Showing @_reportEntries.Count of @reportCounts.Total</span> }
                    </div>
                    @if (_reportsError is not null) { <div class="sc-notice sc-notice--error" role="alert">@_reportsError</div> }
                    @if (_reports is null)
                    {
                        <p class="sc-muted" role="status">Loading daily reports…</p>
                    }
                    else if (_reportEntries.Count == 0)
                    {
                        <div class="sc-empty"><div class="sc-empty__title">No daily report yet</div>
                            <p>The agent writes one for each day it works and keeps it current through the day: what moved the goal forward, and anything you asked for that it held or could not do.</p>
                        </div>
                    }
                    else
                    {
                        <div class="sc-goals__scroll sc-goals__scroll--ledger">
                            <div class="sc-reports" role="list" aria-label="Daily reports">
                                @foreach (var report in _reportEntries.OrderByDescending(entry => entry.Day).ThenByDescending(entry => entry.Sequence))
                                {
                                    var quiet = string.IsNullOrWhiteSpace(report.Achieved);
                                    <article class="sc-report @(report.Held.Count > 0 ? "sc-report--held" : quiet ? "sc-report--clear sc-report--quiet" : "sc-report--clear")" role="listitem" @key="report.Id">
                                        <header class="sc-report__head">
                                            <h3 class="sc-report__day" title="@report.Day.ToString("D")">@SwarmCode.App.Services.AppNavigation.DayLabel(report.Day.ToDateTime(TimeOnly.MinValue))</h3>
                                            <time class="sc-report__updated" datetime="@report.RecordedUtc.ToString("o")" title="@UpdatedTitle(report)">Updated @UpdatedLabel(report)</time>
                                        </header>
                                        <div class="sc-report__body">
                                            <h4 class="sc-report__headline">@report.Headline</h4>
                                            <div class="sc-report__achieved">
                                                @if (quiet)
                                                {
                                                    <p class="sc-muted">Nothing moved the goal forward this day.</p>
                                                }
                                                else
                                                {
                                                    @foreach (var paragraph in Paragraphs(report.Achieved!))
                                                    {
                                                        <p>@foreach (var segment in Segments(paragraph))
                                                        {
                                                            if (segment.Url is { } url) { <a href="@url" target="_blank" rel="noopener noreferrer" title="@url">@segment.Text</a> }
                                                            else { @segment.Text }
                                                        }</p>
                                                    }
                                                }
                                            </div>
                                            @if (report.Metrics.Count > 0)
                                            {
                                                <div class="sc-report__metrics" aria-label="Measured movement">
                                                    @foreach (var (name, value) in report.Metrics) { <span class="sc-chip"><span class="sc-report__metric-name">@name</span> <span class="sc-report__metric-value">@value</span></span> }
                                                </div>
                                            }
                                            @if (report.Held.Count > 0)
                                            {
                                                <div class="sc-report__held" role="group" aria-label="Held requests">
                                                    <div class="sc-report__held-label"><span class="sc-chip sc-chip--danger">Held</span><span>@(report.Held.Count == 1 ? "You asked for this; the agent did not do it" : "You asked for these; the agent did not do them")</span></div>
                                                    <ul>
                                                        @foreach (var item in report.Held)
                                                        {
                                                            <li><strong>@item.Request</strong><span class="sc-report__reason">@item.Reason</span>
                                                            @if (!string.IsNullOrWhiteSpace(item.Unblock)) { <span class="sc-report__unblock"><span class="sc-report__lead">To unblock:</span> @item.Unblock</span> }</li>
                                                        }
                                                    </ul>
                                                </div>
                                            }
                                            @if (report.NextActions.Count > 0)
                                            {
                                                <div class="sc-report__next">
                                                    <span class="sc-report__label">Next</span>
                                                    <ul>@foreach (var action in report.NextActions) { <li>@action</li> }</ul>
                                                </div>
                                            }
                                            @if (report.ResultIds.Count > 0)
                                            {
                                                var recorded = report.ResultIds.Count + (report.ResultIds.Count == 1 ? " result recorded" : " results recorded");
                                                <div class="sc-report__footer">
                                                    @if (Results is not null) { <button type="button" class="sc-report__results" title="Show them under What's been done" @onclick="() => ShowAsync(PanelView.Results)">@recorded</button> }
                                                    else { <span class="sc-muted">@recorded</span> }
                                                </div>
                                            }
                                        </div>
                                    </article>
                                }
                            </div>
                        </div>
                        @if (_reports.HasMore) { <div class="sc-row"><button type="button" class="sc-btn" @onclick="LoadMoreReportsAsync">Show earlier (@(_reports.Total - _reportEntries.Count) more)</button></div> }
                    }
                }
                else if (_view == PanelView.Results)
                {
                    <p class="sc-muted">What this agent has delivered toward the goal, newest first: posts, messages, emails, submissions and releases, with links.</p>
                    <div class="sc-row sc-goals__ledger-controls">
                        <button type="button" class="sc-btn" @onclick="() => RefreshResultsAsync(reset: false)">Refresh</button>
                        @if (_resultsLoading) { <span class="sc-spinner" aria-hidden="true"></span> }
                        @if (_results is { } resultCounts) { <span class="sc-muted">Showing @_resultEntries.Count of @resultCounts.Total</span> }
                    </div>
                    @if (_resultsError is not null) { <div class="sc-notice sc-notice--error" role="alert">@_resultsError</div> }
                    @if (_results is null)
                    {
                        <p class="sc-muted" role="status">Loading results…</p>
                    }
                    else if (_resultEntries.Count == 0)
                    {
                        <div class="sc-empty"><div class="sc-empty__title">Nothing delivered yet</div>
                            <p>The agent records each post, message, email, submission or release here as it happens, with a link. Its step-by-step activity is under All activity.</p>
                        </div>
                    }
                    else
                    {
                        <div class="sc-goals__scroll sc-goals__scroll--ledger">
                            <ol class="sc-ledger" aria-label="What's been done">
                                @foreach (var day in _resultEntries.GroupBy(result => result.OccurredAtUtc.ToLocalTime().Date))
                                {
                                    <li class="sc-ledger__day" @key="day.Key">
                                        <h3 class="sc-ledger__date" title="@day.Key.ToString("D")">@SwarmCode.App.Services.AppNavigation.DayLabel(day.Key)</h3>
                                        <ol class="sc-ledger__entries">
                                            @foreach (var result in day)
                                            {
                                                <li class="sc-ledger__entry sc-ledger__entry--result sc-ledger__entry--@result.State.ToString().ToLowerInvariant()" @key="result.Id">
                                                    <div class="sc-ledger__meta">
                                                        @if (result.Kind != GoalResultKind.Other) { <span class="sc-chip">@ResultKindLabel(result.Kind)</span> }
                                                        @if (!string.IsNullOrWhiteSpace(result.Audience)) { <span class="sc-ledger__audience" title="@result.Audience">@result.Audience</span> }
                                                        @if (result.State != GoalResultState.Done) { <span class="sc-chip @ResultStateChip(result.State)" title="@ResultStateTitle(result.State)">@ResultStateLabel(result.State)</span> }
                                                        <time datetime="@result.OccurredAtUtc.ToString("o")" title="@result.OccurredAtUtc.ToLocalTime().ToString("f")">@result.OccurredAtUtc.ToLocalTime().ToString("t")</time>
                                                    </div>
                                                    <div class="sc-ledger__title">
                                                        @if (!string.IsNullOrWhiteSpace(result.Url)) { <a href="@result.Url" target="_blank" rel="noopener noreferrer" title="@result.Url">@result.Title</a> <span class="sc-ledger__domain">@Host(result.Url)</span> }
                                                        else { @result.Title }
                                                    </div>
                                                    @if (!string.IsNullOrWhiteSpace(result.Summary)) { <p class="sc-muted sc-ledger__summary">@result.Summary</p> }
                                                </li>
                                            }
                                        </ol>
                                    </li>
                                }
                            </ol>
                        </div>
                        @if (_results.HasMore) { <div class="sc-row"><button type="button" class="sc-btn" @onclick="LoadMoreResultsAsync">Show earlier (@(_results.Total - _resultEntries.Count) more)</button></div> }
                    }
                }
                else
                {
                    var spansAttempts = _ledgerEntries.Select(entry => entry.Attempt).Distinct().Skip(1).Any();
                    <p class="sc-muted">Everything this agent has done, newest first, with links to what it published and the files it changed.</p>
                    <div class="sc-row sc-goals__ledger-controls">
                        <label class="sc-toggle"><input type="checkbox" checked="@_includeObservations" @onchange="ToggleObservationsAsync" /><span class="sc-toggle__track" aria-hidden="true"></span><span>Also show what it looked at</span></label>
                        <button type="button" class="sc-btn" @onclick="() => RefreshLedgerAsync(reset: false)">Refresh</button>
                        @if (_ledgerLoading) { <span class="sc-spinner" aria-hidden="true"></span> }
                        @if (_ledger is { } counts) { <span class="sc-muted">Showing @_ledgerEntries.Count of @counts.Total</span> }
                    </div>
                    @if (_ledgerError is not null) { <div class="sc-notice sc-notice--error" role="alert">@_ledgerError</div> }
                    @if (_ledger is null)
                    {
                        <p class="sc-muted" role="status">Loading what's been done…</p>
                    }
                    else if (_ledgerEntries.Count == 0)
                    {
                        <div class="sc-empty"><div class="sc-empty__title">Nothing done yet</div>
                            @if (_includeObservations) { <p>This agent hasn't recorded any work yet.</p> }
                            else { <p>What it publishes, changes, runs and replies will show up here as it works. Turn on "Also show what it looked at" to include reading and searching.</p> }
                        </div>
                    }
                    else
                    {
                        <div class="sc-goals__scroll sc-goals__scroll--ledger">
                            <ol class="sc-ledger" aria-label="What's been done">
                                @foreach (var day in _ledgerEntries.GroupBy(entry => entry.AtUtc.ToLocalTime().Date))
                                {
                                    <li class="sc-ledger__day" @key="day.Key">
                                        <h3 class="sc-ledger__date" title="@day.Key.ToString("D")">@SwarmCode.App.Services.AppNavigation.DayLabel(day.Key)</h3>
                                        <ol class="sc-ledger__entries">
                                            @foreach (var entry in day)
                                            {
                                                <li class="sc-ledger__entry sc-ledger__entry--@entry.Kind.ToString().ToLowerInvariant()" @key="entry.Key">
                                                    <div class="sc-ledger__meta">
                                                        <span class="sc-chip @KindChip(entry.Kind)">@KindLabel(entry.Kind)</span>
                                                        @if (entry.HostVerified) { <span class="sc-chip sc-chip--ok" title="Code checked this result itself">Verified</span> }
                                                        @if (spansAttempts) { <span class="sc-ledger__attempt" title="@("The agent was restarted; this happened during its run " + entry.Attempt)">Attempt @entry.Attempt</span> }
                                                        <time datetime="@entry.AtUtc.ToString("o")" title="@entry.AtUtc.ToLocalTime().ToString("f")">@entry.AtUtc.ToLocalTime().ToString("t")</time>
                                                    </div>
                                                    <div class="sc-ledger__title">@entry.Title</div>
                                                    @if (!string.IsNullOrWhiteSpace(entry.Summary)) { <p class="sc-muted sc-ledger__summary">@entry.Summary</p> }
                                                    else if (entry.Kind == CodingGoalLedgerKind.Uncertain) { <p class="sc-muted sc-ledger__summary">Started in an earlier attempt and never reported back. Check before repeating it.</p> }
                                                    @if (entry.Links.Count > 0)
                                                    {
                                                        <ul class="sc-ledger__links" aria-label="Links">
                                                            @foreach (var link in entry.Links) { <li><a href="@link.Url" target="_blank" rel="noopener noreferrer" title="Opens in your browser">@link.Label</a></li> }
                                                        </ul>
                                                    }
                                                    @if (entry.Files.Count > 0)
                                                    {
                                                        <ul class="sc-ledger__files" aria-label="Files">
                                                            @foreach (var file in entry.Files)
                                                            {
                                                                <li><code title="@file">@FileLabel(file)</code>
                                                                @if (_openableFiles.Contains(file)) { <button type="button" class="sc-btn sc-btn--sm sc-btn--ghost" aria-label="@("Open " + FileLabel(file))" @onclick="() => OpenFileAsync(file)">Open</button> }</li>
                                                            }
                                                        </ul>
                                                    }
                                                </li>
                                            }
                                        </ol>
                                    </li>
                                }
                            </ol>
                        </div>
                        @if (_ledger.HasMore) { <div class="sc-row"><button type="button" class="sc-btn" @onclick="LoadMoreLedgerAsync">Show earlier (@(_ledger.Total - _ledgerEntries.Count) more)</button></div> }
                    }
                }
            }
        </div>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public IGoalMailbox Mailbox { get; set; } = default!;
    [Parameter] public Guid? InitialGoalId { get; set; }
    [Parameter] public bool Poll { get; set; } = true;
    /// <summary>Optional host ledger; without it the panel shows messages only.</summary>
    [Parameter] public ICodingGoalLedger? Ledger { get; set; }
    /// <summary>Optional host results ledger: what the agent delivered (posts, messages, emails, submissions).</summary>
    [Parameter] public IGoalResultLedger? Results { get; set; }
    /// <summary>Optional host daily reports: what the agent achieved each day and what it held or could not do.</summary>
    [Parameter] public IGoalReportLedger? Reports { get; set; }
    /// <summary>"reports" opens Daily reports; "done" opens What's been done (results, or the activity ledger when no results ledger is wired); "activity" opens the activity ledger.</summary>
    [Parameter] public string? InitialView { get; set; }
    private enum PanelView { Messages, Ledger, Results, Reports }
    private const int ReportsPage = 30;
    private GoalReportPage? _reports;
    private List<GoalReport> _reportEntries = [];
    private bool _reportsLoading, _reportsRefreshAgain;
    private string? _reportsError;
    private const int ResultsPage = 50;
    private GoalResultPage? _results;
    private List<GoalResult> _resultEntries = [];
    private bool _resultsLoading, _resultsRefreshAgain;
    private string? _resultsError;
    private const int LedgerPage = 50;
    private PanelView _view;
    private string? _appliedInitialView;
    private CodingGoalLedgerPage? _ledger;
    private List<CodingGoalLedgerEntry> _ledgerEntries = [];
    private HashSet<string> _openableFiles = new(StringComparer.Ordinal);
    private bool _includeObservations, _ledgerLoading, _ledgerRefreshAgain;
    private string? _ledgerError;
    private IReadOnlyList<GoalContact> _contacts = [];
    private IReadOnlyList<GoalInboxMessage> _messages = [];
    private IReadOnlyList<GoalReply> _replies = [];
    private GoalContact? _contact;
    private Guid? _selected, _appliedInitial;
    private bool _loading = true, _refreshing, _refreshAgain, _hasMore, _renaming, _renameBusy, _disposed;
    private long _cursor;
    private string? _error;
    private string? _renameError;
    private string _name = "", _handle = "";
    private long _renameRevision;
    private Guid _renameGoal;
    private readonly CancellationTokenSource _lifetime = new();
    private GoalInboxDraft? Draft => _selected is { } id ? GoalInboxDraft.For(Mailbox, "goal:" + id) : null;
    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        if (Poll) _ = PollAsync();
    }
    protected override async Task OnParametersSetAsync()
    {
        if (_appliedInitialView != InitialView)
        {
            _appliedInitialView = InitialView;
            _view = string.Equals(InitialView, "reports", StringComparison.OrdinalIgnoreCase) && Reports is not null ? PanelView.Reports
                : string.Equals(InitialView, "done", StringComparison.OrdinalIgnoreCase)
                ? Results is not null ? PanelView.Results : Ledger is not null ? PanelView.Ledger : PanelView.Messages
                : string.Equals(InitialView, "activity", StringComparison.OrdinalIgnoreCase) && Ledger is not null ? PanelView.Ledger
                : PanelView.Messages;
        }
        if (_appliedInitial != InitialGoalId)
        {
            _appliedInitial = InitialGoalId;
            if (InitialGoalId is { } id) await SelectAsync(id);
        }
    }
    private async Task PollAsync()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
            while (await timer.WaitForNextTickAsync(_lifetime.Token))
                await InvokeAsync(async () => { await RefreshAsync(); if (!_disposed) StateHasChanged(); });
        }
        catch (OperationCanceledException) { }
    }
    private async Task SelectAsync(Guid id)
    {
        _selected = id; _contact = null; _cursor = 0; _messages = []; _replies = []; _renaming = false;
        _ledger = null; _ledgerEntries = []; _openableFiles = new(StringComparer.Ordinal); _ledgerError = null;
        _results = null; _resultEntries = []; _resultsError = null;
        _reports = null; _reportEntries = []; _reportsError = null;
        await RefreshAsync();
    }
    private async Task RefreshAsync()
    {
        if (_disposed || _lifetime.IsCancellationRequested) return;
        if (_refreshing) { _refreshAgain = true; return; }
        _refreshing = true;
        var selected = _selected; var cursor = _cursor;
        try
        {
            var data = await Task.Run(async () =>
            {
                var contacts = await Mailbox.ListAsync(_lifetime.Token);
                var messages = new List<GoalInboxMessage>(); var replies = new List<GoalReply>();
                GoalContact? contact = contacts.SingleOrDefault(c => c.GoalId == selected);
                var more = false; var next = cursor;
                if (contact is not null)
                {
                    var thread = await Mailbox.ReadAsync(contact.GoalId, cursor, 200, _lifetime.Token);
                    contact = thread.Contact; messages.AddRange(thread.Messages); replies.AddRange(thread.Replies);
                    more = thread.HasMore; next = thread.NextSequence;
                    if (more && next <= cursor) throw new InvalidOperationException("The inbox page cursor did not advance.");
                }
                return (contacts, contact, messages, replies, more, next);
            });
            if (selected != _selected) return;
            _contacts = data.contacts; _contact = data.contact;
            _messages = _messages.Concat(data.messages).GroupBy(m => m.Id).Select(group => group.MaxBy(m => m.Sequence)!).ToArray();
            _replies = _replies.Concat(data.replies).GroupBy(r => r.Id).Select(group => group.MaxBy(r => r.Sequence)!).ToArray();
            _hasMore = data.more; _cursor = data.next;
            _error = null;
            if (_view == PanelView.Ledger) await RefreshLedgerAsync(reset: false);
            else if (_view == PanelView.Results) await RefreshResultsAsync(reset: false);
            else if (_view == PanelView.Reports) await RefreshReportsAsync(reset: false);
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception) { _error = "The agent inbox could not refresh. Your drafts are kept. Try Refresh again."; }
        finally
        {
            _refreshing = false; _loading = false;
            if (_refreshAgain) { _refreshAgain = false; await RefreshAsync(); }
        }
    }

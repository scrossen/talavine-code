@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="composer-model" @ref="_root">
    <button type="button" class="composer-model__trigger" popovertarget="@_id" @onclick="OnOpening"
            title="@($"{ProviderLabel} · {Model}")" aria-label="Provider, model and reasoning effort" aria-haspopup="dialog">
        <span class="composer-model__provider">@(ProviderLabel ?? "Provider")</span><span aria-hidden="true">·</span>
        <span class="composer-model__name">@DisplayModel</span>
        <span class="composer-model__effort">@EffortLabel</span>
        @if (!string.IsNullOrEmpty(AssistanceSummary)) { <span title="@AssistanceSummary" aria-label="@AssistanceSummary">&#9678;</span> }<span aria-hidden="true">⌄</span>
    </button>
    <div id="@_id" class="composer-model__popover" popover="auto" role="dialog" aria-label="Provider, model and reasoning settings" @onkeydown:stopPropagation>
        <ChatReasoningPicker Efforts="Efforts" Effort="@Effort" EffortChanged="EffortChanged" Disabled="Disabled" />
        @FavoriteControls
        <details class="composer-model__choices">
            <summary title="Choose a provider or model">@DisplayModel <span aria-hidden="true">›</span></summary>
            <div class="composer-model__fields">@ChildContent</div>
        </details>
        @AssistanceControls
    </div>
</div>

@code {
    [Parameter] public string Model { get; set; } = "";
    [Parameter] public string ProviderLabel { get; set; } = "";
    [Parameter] public string? Effort { get; set; }
    [Parameter] public EventCallback<string?> EffortChanged { get; set; }
    [Parameter] public IReadOnlyList<string> Efforts { get; set; } = [];
    [Parameter] public EventCallback OnOpening { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? AssistanceSummary { get; set; }
    [Parameter] public RenderFragment? AssistanceControls { get; set; }
    [Parameter] public RenderFragment? FavoriteControls { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private readonly string _id = "composer-model-" + Guid.NewGuid().ToString("N");
    private ElementReference _root;
    private IJSObjectReference? _module;
    private string DisplayModel => string.IsNullOrWhiteSpace(Model) ? "Choose model" : Model;
    private string EffortLabel => Effort ?? "";
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/SwarmCore.Chat.Components/composerModelPicker.js");
        await _module.InvokeVoidAsync("initialize", _root);
    }
    public async Task OpenAsync()
    {
        if (_module is not null) await _module.InvokeVoidAsync("open", _root);
    }
    public async ValueTask DisposeAsync()
    {
        if (_module is null) return;
        try { await _module.InvokeVoidAsync("dispose", _root); await _module.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}

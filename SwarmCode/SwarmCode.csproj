<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>swarmcode</AssemblyName>
    <RootNamespace>SwarmCode</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
    <Description>Talavine Code - terminal coding agent hosted on the SwarmCore runtime.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0-rc.2.26504.105" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="11.0.0-rc.2.26504.105" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="11.0.0-rc.2.26504.105" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SwarmCode.Hosting\SwarmCode.Hosting.csproj" />
    <ProjectReference Include="..\SwarmCore\SwarmCore.Coding\SwarmCore.Coding.csproj" />
    <ProjectReference Include="..\SwarmCore\SwarmCore.LlmRouting\SwarmCore.LlmRouting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

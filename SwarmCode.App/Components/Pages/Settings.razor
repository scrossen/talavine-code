    @if (AppState.SelfImprovementAvailable)
    {
    <SettingsDialog Id="improvement" Title="Self-improvement" Description="Idle cycles and development preferences." Filter="@_settingsSearch" Message="@_message" IsError="@_messageIsError">
    <section class="sc-card">
        <h2 class="sc-card__title">Self-improvement</h2>
        <p class="sc-card__copy">Talavine Code fixes its own defects and builds features people asked it for, in an isolated worktree of its source, while nobody is using it. Each cycle must pass the build and test checks before its branch is kept. See the <a href="/self-improvement">Self-improvement</a> page for the backlog.</p>
        <div class="sc-list">
            <div class="sc-list__row">
                <label class="sc-toggle">
                    <input type="checkbox" @bind="_selfImprovement.Enabled" />
                    <span class="sc-toggle__track"></span>
                    <span>Observe defects and feature requests, and run improvement cycles when idle</span>
                </label>
            </div>
            <div class="sc-list__row">
                <label class="sc-field__label" for="sc-si-repo">Talavine Code source repository</label>
                <input id="sc-si-repo" class="sc-input sc-input--mono" placeholder="@(_selfImprovementDetected ?? "Not found: enter the checkout folder")" value="@_selfImprovement.RepositoryRoot"
                       @onchange="e => _selfImprovement.RepositoryRoot = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value!.ToString()!.Trim()" />
                <p class="sc-muted sc-note">@(!string.IsNullOrWhiteSpace(_selfImprovement.RepositoryRoot) ? "Repair cycles use the configured source folder after these settings are saved." : _selfImprovementDetected is null ? "No checkout was detected near this build; set a source folder to enable repair cycles." : "Empty uses the detected checkout: " + _selfImprovementDetected)</p>
            </div>
            <div class="sc-row">
                <div class="sc-field"><label class="sc-field__label" for="sc-si-idle">Quiet minutes before a cycle starts</label><input id="sc-si-idle" class="sc-input" type="number" min="1" max="720" @bind="_selfImprovementIdleMinutes" /></div>
                <div class="sc-field"><label class="sc-field__label" for="sc-si-attempts">Attempts for ordinary repairs</label><input id="sc-si-attempts" class="sc-input" type="number" min="1" max="10" @bind="_selfImprovement.MaxAttemptsPerItem" /></div>
                <div class="sc-field"><label class="sc-field__label" for="sc-si-lane">Lane (empty: your default)</label><input id="sc-si-lane" class="sc-input" @bind="_selfImprovement.Lane" /></div>
            </div>
            <div class="sc-list__row">
                <label class="sc-toggle"><input type="checkbox" @bind="_selfImprovement.AllowNativeLanes" /><span class="sc-toggle__track"></span><span>Let native CLI lanes (Claude Code, Codex) run cycles unattended</span></label>
            </div>
            <div class="sc-list__row">
                <label class="sc-toggle"><input type="checkbox" @bind="_selfImprovement.StopWhenUserReturns" /><span class="sc-toggle__track"></span><span>Stop a running cycle when you come back (it waits for the next quiet moment)</span></label>
            </div>
            <div class="sc-list__row">
                <label class="sc-toggle"><input type="checkbox" @bind="_selfImprovement.AllowUnderDebugger" /><span class="sc-toggle__track"></span><span>Let cycles start while a debugger is attached (the "self-improvement" VS Code launch profile sets this)</span></label>
            </div>
            <div class="sc-list__row">
                <label class="sc-toggle"><input type="checkbox" @bind="_selfImprovement.MergeVerifiedFixes" /><span class="sc-toggle__track"></span><span>Automatically merge ordinary verified fixes when the source checkout is clean and unchanged</span></label>
                <label class="sc-toggle"><input type="checkbox" @bind="_selfImprovement.AutoApplyGoalRepairs" /><span class="sc-toggle__track"></span><span>Automatically merge and install verified goal repairs when idle, then continue saved goals after restart</span></label>
                <p class="sc-muted sc-note">Completed actions stay recorded. Paused or cancelled goals stay stopped. An uncertain send still needs verification before it can be repeated.</p>
                <p class="sc-muted sc-note">Automatic goal repairs keep retrying with backoff. The attempt limit above applies to ordinary repairs.</p>
                <p class="sc-muted sc-note">With both options off, verified fixes stay on their own <code>swarmcode/self-improvement-…</code> branches for you to review and merge. Build and test commands are discovered from the repository; override them under <code>Coding:SelfImprovement:Checks</code> in <code>@SettingsFile.Path</code>.</p>
            </div>
            <div class="sc-row">
                <button type="button" class="sc-btn sc-btn--primary" disabled="@_busy" @onclick="SaveSelfImprovementAsync">Save self-improvement settings</button>
            </div>
        </div>
    </section>
    </SettingsDialog>
    }
    <SettingsDialog Id="data" Title="Data and logs" Description="Find local files and storage information." Filter="@_settingsSearch" Message="@_message" IsError="@_messageIsError">
    <section class="sc-card">
        <h2 class="sc-card__title">Data</h2>
        <p class="sc-card__copy">Where Talavine Code keeps its sessions, settings, secrets, and logs on this computer.</p>
        <div class="sc-list">
            <div class="sc-list__row">
                <div class="sc-grow"><div class="sc-field__label">Data folder</div><div class="sc-mono">@State.Paths.RootDirectory</div></div>
                <button type="button" class="sc-btn sc-btn--sm" @onclick="() => FolderLauncher.OpenAsync(State.Paths.RootDirectory)">Open folder</button>
            </div>
            <div class="sc-list__row">
                <div class="sc-grow"><div class="sc-field__label">Secret vault</div><div class="sc-mono">@State.Paths.SecretsDbPath</div></div>
                <span class="sc-chip @(State.KeyStore.IsAvailable ? "sc-chip--ok" : "sc-chip--warn")">@KeyStoreLabel</span>
            </div>
            <div class="sc-list__row">
                <div class="sc-grow"><div class="sc-field__label">Log file</div><div class="sc-mono">@(DesktopHost.LogPath ?? State.Paths.LogPath)</div></div>
                <button type="button" class="sc-btn sc-btn--sm" @onclick="OpenLogFolder">Open folder</button>
            </div>
        </div>
    </section>
    <section class="sc-card">
        <h2 class="sc-card__title">Goal history</h2>
        <p class="sc-card__copy">
            Talavine Code saves a record of everything an agent ran for a goal, with the full output, so you can check the work later.
            Trimming removes the full output from old records once the work is closed; it keeps what happened, a short excerpt and a
            fingerprint of the output. Goals that are still working are never touched.
        </p>
        <label class="sc-toggle">
            <input type="checkbox" checked="@Prefs.CompactGoalReceipts" disabled="@_compacting" aria-label="Trim old goal records while Talavine Code is idle"
                   @onchange="e => UpdatePref(p => p.CompactGoalReceipts = (bool)e.Value!)" />
            <span class="sc-toggle__track"></span><span>Trim old goal records while Talavine Code is idle</span>
        </label>
        <p class="sc-muted sc-note">Applies a month after an attempt is closed, or a week after a goal finishes.</p>
        @if (_goalStorageError is { } storageError)
        {
            <div class="sc-notice sc-notice--error" role="alert">Couldn't read the goals folder: @storageError</div>
        }
        else if (_goalStorage is null)
        {
            <Spinner />
        }
        else
        {
            var storage = _goalStorage;
            <div class="sc-list">
                <div class="sc-list__row">
                    <div class="sc-grow"><div class="sc-field__label">Goal list</div><div class="sc-mono">@Path.Combine(storage.Directory, "objectives.json")</div></div>
                    <span class="sc-chip">@GoalReceiptCompaction.Size(storage.InventoryBytes)</span>
                </div>
                <div class="sc-list__row">
                    <div class="sc-grow"><div class="sc-field__label">Saved outputs</div><div class="sc-muted">@(storage.BodyLogs == 0 ? "No goal history yet." : $"{storage.BodyLogs} file{(storage.BodyLogs == 1 ? "" : "s")} in receipt-bodies")</div></div>
                    @if (storage.BodyLogs > 0) { <span class="sc-chip">@GoalReceiptCompaction.Size(storage.BodyLogBytes)</span> }
                </div>
            </div>
            @if (storage.Stray.Count > 0)
            {
                <p class="sc-muted sc-note">
                    @storage.Stray.Count item@(storage.Stray.Count == 1 ? "" : "s") in the goals folder that Talavine Code does not use (@GoalReceiptCompaction.Size(storage.StrayBytes)),
                    left by other programs or a backup copy. Delete them yourself if you no longer need them; Talavine Code never removes them.
                </p>
                <div class="sc-list">
                    @foreach (var file in storage.Stray)
                    {
                        <div class="sc-list__row">
                            <div class="sc-grow sc-mono">@StrayLabel(storage, file)</div>
                            <span class="sc-chip">@GoalReceiptCompaction.Size(file.Bytes)</span>
                        </div>
                    }
                </div>
            }
        }
        <p class="sc-muted sc-note">@CompactionStatus</p>
        <div class="sc-row">
            <button type="button" class="sc-btn sc-btn--sm" disabled="@_compacting" aria-busy="@(_compacting ? "true" : "false")" @onclick="CompactNowAsync">@(_compacting ? "Trimming…" : "Trim now")</button>
            <button type="button" class="sc-btn sc-btn--sm" disabled="@_compacting" @onclick="LoadGoalStorageAsync">Check again</button>
            <button type="button" class="sc-btn sc-btn--sm" @onclick="OpenGoalsFolder">Open goals folder</button>
        </div>
        <p class="sc-muted sc-note">Trim now runs one pass right away, even with the switch off. Trimmed outputs can't be brought back; goals still working are left alone.</p>
    </section>
    </SettingsDialog>
    </div>
    </details>
</div>

@code {
    // One settings file instance per app, shared with the rest of the shell.
    private UserSettingsFile SettingsFile => State.UserSettings;
    private string _settingsSearch = "";
    private static readonly string[] ByokProviders = ["OpenAI", "Claude", "Gemini", "OpenRouter", "DeepSeek", "Grok", "HuggingFace", "Venice"];
    private static readonly string[] KnownProviders = ["ClaudeCodeNative", "CodexNative", "GeminiCliNative", "ClaudeCode", "CodexCli", "OpenAI", "Claude", "Gemini", "OpenRouter", "DeepSeek", "Grok", "HuggingFace", "Venice", "Ollama", "LMStudio"];

    /// <summary>Why native lanes are dimmed while a mode asks or deny rules exist (the orchestrator skips them and says so in the chat).</summary>
    private const string NativeApprovalNote =
        "Native lanes (Claude Code, Codex, Gemini CLI agents) run their own tools without Talavine Code's prompts and rules, so while the mode asks or deny rules exist they are skipped and the next non-native lane runs instead.";

    private CodingPermissionRules _permissionRules = new();
    private RepositoryPermissionInspection? _repositoryRules;

    private bool NativeOff => CodingPermissionPolicy.From(Prefs.Mode, RepositoryPermissionRules.Merge(_permissionRules, _repositoryRules)).Restricts;

    /// <summary>Reads the open repository's own permission rules and whether their allow rules are approved.</summary>
    private async Task LoadRepositoryRulesAsync()
    {
        if (State.Workspace is not { } workspace) { _repositoryRules = null; return; }
        var services = workspace.Services;
        var root = workspace.RepositoryRoot;
        try { _repositoryRules = await Task.Run(() => SwarmCodePermissions.InspectRepositoryAsync(services, root)); }
        catch (Exception) { _repositoryRules = null; }
    }

    private async Task DecideRepositoryRulesAsync(RepositoryPermissionInspection rules, bool allow)
    {
        if (State.Workspace is not { } workspace || workspace.Services.GetService<ICodingRepositorySettingsApprovalStore>() is not { } approvals) return;
        _busy = true;
        try
        {
            var root = workspace.RepositoryRoot;
            if (allow && rules.Sha256 is { } sha) await Task.Run(() => approvals.ApproveAsync(root, sha));
            else if (!allow) await Task.Run(() => approvals.RevokeAsync(root));
            await LoadRepositoryRulesAsync();
        }
        catch (Exception ex) { _repositoryRulesError = "Could not save the decision: " + ex.Message; }
        finally { _busy = false; }
    }

    private string? _repositoryRulesError;

    private void SetTheme(ChangeEventArgs e) => UpdatePref(p => p.Theme = e.Value?.ToString() ?? "system");

    private void SetMode(object? value)
    {
        if (CodingPermissionPolicy.TryParse(value?.ToString(), out var mode)) UpdatePref(p => p.SetMode(mode));
    }

    internal static string ModeNote(CodingPermissionMode mode) => mode switch
    {
        CodingPermissionMode.AskRisky => "Reads and file edits in the workspace run; commands, git commit/push, sends, deletions and computer/browser control wait for your approval.",
        CodingPermissionMode.Ask => "Every action with a side effect waits for your approval; reads run.",
        _ => "Your request authorizes the tools it needs; nothing waits for approval.",
    };

    private static RenderFragment RuleList(IReadOnlyList<string> rules) => builder =>
    {
        if (rules.Count == 0) { builder.AddContent(0, "none"); return; }
        var seq = 0;
        foreach (var rule in rules)
        {
            builder.OpenElement(seq++, "code");
            builder.AddContent(seq++, rule);
            builder.CloseElement();
            builder.AddContent(seq++, " ");
        }
    };


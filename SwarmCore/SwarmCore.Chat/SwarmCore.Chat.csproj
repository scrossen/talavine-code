<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SwarmCore.Chat</RootNamespace>
    <Description>Shared, host-agnostic chat building blocks for the Swarm family: image attachments, on-demand vision description, and model-picker resolution with vision gating and per-surface "last choice" memory. Any app embeds these over its own ILlmRouter — no app-specific types.</Description>
    <Authors>Scott Crossen</Authors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0-rc.2.26504.105" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0-rc.2.26504.105" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SwarmCore.Abstractions\SwarmCore.Abstractions.csproj" />
    <ProjectReference Include="..\SwarmCore.LlmRouting\SwarmCore.LlmRouting.csproj" />
  </ItemGroup>
</Project>

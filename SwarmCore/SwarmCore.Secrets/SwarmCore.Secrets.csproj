<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Description>SwarmCore Secrets - the Swarm family keystore strategy: OS-keystore envelope protection (DPAPI / Keychain) for values at rest, a SQLite secret vault addressed by name, {{secret:name}} references for agents, and password-manager CSV import. No application dependencies.</Description>
    <Authors>Scott Crossen</Authors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0-rc.2.26504.105" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0-rc.2.26504.105" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="11.0.0-rc.2.26504.105" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SwarmCore.Secrets.Tests" />
  </ItemGroup>
</Project>

@page "/session/{SessionId}"
@implements IDisposable
@inject AppState App
@inject NavigationManager Nav

<PageTitle>@(_session?.Title ?? "Session") - Talavine Code</PageTitle>

@if (App.Workspace is null && !App.IsOpeningWorkspace)
{
    <div class="sess-empty-page">
        <div class="sess-card">
            <h2>Open a repository</h2>
            <p>Sessions belong to a repository. Open one to continue.</p>
            <a class="sess-btn sess-btn--primary" href="/">Open a repository</a>
        </div>
    </div>
}
else if (_loading || App.IsOpeningWorkspace)
{
    <div class="sess-empty-page"><Spinner /></div>
}
else if (_session is null)
{
    <div class="sess-empty-page">
        <div class="sess-card">
            <h2>Session not found</h2>
            <p>This session no longer exists.</p>
            <button type="button" class="sess-btn sess-btn--primary" @onclick="NewSessionAsync">New session</button>
        </div>
    </div>
}
else if (_runner is null)
{
    <div class="sess-empty-page">
        <div class="sess-card">
            <h2>Different repository</h2>
            <p>This session belongs to <strong>@App.ProjectName(_session.RepositoryRoot)</strong>, but <strong>@App.ProjectName(App.RepositoryRoot)</strong> is open.</p>
            <p class="sess-muted">@_session.RepositoryRoot</p>
            @if (_openError is not null) { <p class="sess-error">@_openError</p> }
            <button type="button" class="sess-btn sess-btn--primary" @onclick="OpenSessionRepositoryAsync">Open @App.ProjectName(_session.RepositoryRoot)</button>
        </div>
    </div>
}
else
{
    var useGoalState = _runner.IsGoalJob || _runner.HasUnfinishedGoal;
    var activity = SessionActivityView.Create(_runner.IsRunning, _runner.JobState, _runner.Goal, _runner.Entries, _localRuntimeStatus, _runner.Phase, useGoalState, plan: _runner.Plan, jobStartedUtc: _runner.JobStartedUtc);
    <div class="sess-page @(_showChanges ? "sess-page--changes" : "")" tabindex="-1" @onkeydown="OnPageKeyDown">
        <div class="sess-main">
            <SessionHeader Title="@_session.Title"
                           RepositoryName="@App.ProjectName(_session.RepositoryRoot)"
                           RepositoryPath="@(App.Paths.IsChatWorkspace(_session.RepositoryRoot) ? null : _session.RepositoryRoot)"
                           Lane="@(_runner.ActiveLane ?? _lane)"
                           Model="@(_runner.ActiveModel ?? _model)"
                           ArtifactsOpen="_showArtifacts"
                           OnToggleArtifacts="ToggleArtifacts"
                           IsRunning="_runner.IsRunning"
                           DisplayStatus="@activity.State"
                           ChangesOpen="_showChanges"
                           ChangeCount="_changeCount"
                           OnRename="RenameAsync"
                           OnToggleChanges="ToggleChanges"
                           OnNewSession="NewSessionAsync"
                           OnFork="ForkSessionAsync"
                           ForkedFromId="@_session.ForkedFromSessionId"
                           ForkUnavailable="@(_forking || _session.ParentSessionId is not null)"
                           ParentId="@_session.ParentSessionId"
                           ParentTitle="@_parentTitle"
                           CreatedUtc="_session.CreatedUtc"
                           LastActivityUtc="_session.LastActivityUtc"
                           ActiveAgents="@App.Agents.Children(_session.Id).Count(a => a.State == SwarmCore.Coding.Agents.AgentState.Running)"
                           WaitingAgents="@App.Agents.Children(_session.Id).Count(a => a.State == SwarmCore.Coding.Agents.AgentState.Queued)" />
            @if (_runner.Goal is { } repairGoal && App.GoalRepairProgress(repairGoal) is { } repairActivity)
            {
                <p class="sess-current__reason" role="status">@repairActivity <a href="/self-improvement">View harness repair</a></p>
            }
            <GitHubStarInvitationHost Allowed="@(_session.ParentSessionId is null && !_session.Temporary && !_runner.PlanMode && _runner.JobState == "Completed" && _runner.Acceptance?.Status != CodingAcceptanceStatus.Failed && App.ScheduledRuns.TryGetRunner(SessionId) is null)"
                                      Busy="@(App.HasActiveOrQueuedWork || App.LastError is not null)"
                                      IsWorkBusy="@(() => App.HasActiveOrQueuedWork || App.LastError is not null)" />
            <BackgroundShellStrip Manager="@(App.Workspace?.Services.GetService<SwarmCore.Coding.Tools.BackgroundShell.BackgroundShellManager>())" SessionId="@_session.Id" />
            <div class="sess-memory-bar">
                <label class="sc-toggle" title="A temporary session neither uses nor adds to what Talavine Code remembers about you.">
                    <input type="checkbox" checked="@_session.Temporary" @onchange="ToggleTemporaryAsync" aria-label="Temporary session (memory off)" />
                    <span class="sc-toggle__track"></span><span>Temporary (memory off)</span>
                </label>
                @if (!App.Preferences.Current.PersonalMemoryEnabled || !App.MemoryOptions.Enabled)
                {
                    <span class="sc-muted">Memory is off. <a href="/settings/memory">Settings &gt; Memory</a></span>
                }
            </div>

            <RepoHooksPrompt Workspace="App.Workspace" />
            <RepoSettingsPrompt Workspace="App.Workspace" />
            @if (_runner.IsRunning || _runner.Entries.Count > 0 || useGoalState && _runner.Goal is not null)
            {
            <SessionActivity Activity="activity"
                             InboxUrl="@(useGoalState && _runner.Goal is { } activityGoal ? $"/goals/{activityGoal.Id:D}" : null)">
                <Controls>
                @if (useGoalState && _runner.Goal is { } goal)
                {
                    <div class="sess-current__controls">
                        @if (_runner.HasUnfinishedGoal)
                        {
                            @if (_runner.IsGoalRunning) { <button type="button" class="sess-btn" @onclick='() => RunGoalCommandAsync("pause", [])'>Pause</button> }
                            else { <button type="button" class="sess-btn" disabled="@(_runner.IsRunning || _runner.PlanMode)" @onclick='() => RunGoalCommandAsync("resume", [])'>Resume</button> }
                        }
                        <a class="sess-btn" href="@($"/goals/{goal.Id:D}?view=reports")">Daily reports</a>
                        <a class="sess-btn" href="@($"/goals/{goal.Id:D}?view=done")">What's been done</a>
                        <details class="sess-current__diagnostics"><summary>Work details</summary><p>@goal.ObjectiveText</p>
                        @if (_runner.HasUnfinishedGoal) { <button type="button" class="sess-btn" @onclick='() => RunGoalCommandAsync("cancel", [])'>Cancel goal</button> }</details>
                    </div>
                }
                </Controls>
            </SessionActivity>
            }
            <div class="sess-body">
                <ChatScrollRegion @ref="_scroll" AutoFollow="true">
                    @{
                        var entries = _runner.Entries;
                    }
                    @if (entries.Count == 0 && _notes.Count == 0)
                    {
                        <SessionWelcome HasProject="App.HasProject" OnChoose="UseExampleAsync" />
                    }
                    @{
                        _recoveryNoticeId = FindRecoveryNotice(entries, _runner.IsRunning);
                    }
                    <SessionTranscript @key="_session.Id" Entries="entries" EntryContent="RenderEntry" />
                    @if (activity.Busy && ShowWorkingIndicator(entries))
                    {
                        <div class="sess-working"><span class="sc-spinner"></span> @(_localRuntimeStatus ?? "Working…")</div>
                    }
                    @foreach (var note in _notes)
                    {
                        <ChatNotice @key="note.Id" Kind="@note.Kind" Text="@note.Text" Details="@note.Details" />
                    }
                </ChatScrollRegion>
            </div>

            <div class="sess-footer">
                <div class="sess-footer-activity">
                @if (_runner.JobState != "Idle")
                {
                    <div class="sess-job-status">
                        <details class="sess-job-details sess-run-details">
                            <summary>Run details · @_runner.CompletedToolCalls tools</summary>
                            <div class="sess-job-details__body">
                                <span>@ToolCallSummary.FormatElapsed(_runner.Elapsed) elapsed</span>
                                @if (_runner.ActiveLane is { } activeLane) { <span>@activeLane</span> }
                                @if (_runner.Phase is { } phase) { <span>Phase: @phase</span> }
                                <span>@(_runner.ReportedTokens is { } tokens ? $"{tokens:N0} reported tokens" : "Token usage unavailable")</span>
                                @if (_runner.ReportedCostUsd is { } cost) { <span>$@cost.ToString("0.0000") reported cost</span> }
                            </div>
                        </details>
                        @if (!_runner.IsGoalJob && _runner.Acceptance is { } acceptance) { <span>@AcceptanceLabel(acceptance.Status)</span> }
                        @if (_runner.HasInterruptedWork)
                        {
                            <button type="button" class="sess-btn" @onclick="ContinueInterruptedWork">Continue interrupted work</button>
                        }
                        @if (!_runner.IsRunning && _runner.QueuePaused && _runner.QueuedMessages.Count > 0)
                        {
                            <span class="sess-muted">· @_runner.QueuedMessages.Count queued, paused</span>
                            <button type="button" class="sess-btn" @onclick="ResumeQueueAsync">Run queued follow-ups</button>
                        }
                    </div>
                }
                <PlanChecklist Plan="_runner.Plan" AwaitingApproval="_runner.PlanAwaitingApproval" OnApprove="ApprovePlanAsync" />
                <LocalRuntimeQueue @key="SessionId" OwnerId="@SessionId" IsRunning="_runner.IsRunning"
                    ReadQueue="_runner.ReadLocalRuntimeQueueAsync" OnStop="StopAsync" OnChooseModel="OpenRuntimeModelChoicesAsync"
                    OnStatusChanged="status => _localRuntimeStatus = status" />
                <QueuedMessages Items="_runner.QueuedMessages" IsRunning="_runner.IsRunning" OnRemove="RemoveQueued" OnEdit="EditQueuedAsync" OnSteer="SteerQueuedAsync" />
                @if (GoalDraft.Pending is not null)
                {
                    <div class="sess-job-status" role="status"><span>Message delivery not confirmed. Your draft is kept.</span>
                    <button type="button" class="sess-btn" @onclick="RetryGoalMessageAsync">Retry same message</button></div>
                }
                </div>
                <AttachmentIntake @ref="_attachmentIntake" Compact="true" PickerId="@("session-attachments-" + SessionId)" @key="SessionId" SessionId="@SessionId" @bind-Files="_attachments" BusyChanged="value => _attachmentsBusy = value" OnOpen="OpenArtifact">
                <ChatComposer Compact="true" @ref="_composer"
                              HasAttachments="@(_attachments.Count > 0)"
                              Disabled="_attachmentsBusy"
                              Value="@_draft"
                              ValueChanged="OnDraftChanged"
                              Placeholder="@(UsesGoalInbox ? "Send an idea or question to this agent…" : _runner.IsRunning ? (_sendMode == "steer" ? "Correct the current task…" : "Queue a follow-up…") : (App.HasProject ? "Ask Talavine Code to work on this project" : "Ask Talavine Code anything"))"
                              IsRunning="_runner.IsRunning"
                              ShowSendWhileRunning="true"
                              SendLabel="@(UsesGoalInbox ? "Send to agent inbox" : _runner.IsRunning ? (_sendMode == "steer" ? "Steer now" : "Queue") : "Send")"
                              OnSend="OnSendAsync"
                              OnStop="StopAsync"
                              SlashCommands="SlashCommands">
                    <Toolbar>
                        <button type="button" class="sess-composer-icon" title="Attach files (or paste / drop files)" aria-label="Attach files" disabled="@_attachmentsBusy" @onclick="() => _attachmentIntake!.PickAsync()">+</button>
                        @{ var permissionMode = App.Preferences.Current.Mode; }
                        <button type="button" class="sess-approval @(permissionMode == CodingPermissionMode.Auto ? "" : "sess-approval--on")" @onclick="CyclePermissionMode"
                                title="@(Settings.ModeNote(permissionMode)) Click to change; allow and deny rules are in Settings.">
                            @(permissionMode switch { CodingPermissionMode.AskRisky => "Ask risky", CodingPermissionMode.Ask => "Ask", _ => "Auto" })
                        </button>
                        <ComposerModelPicker @ref="_runtimeModelPicker" Model="@_model" ModelChanged="SaveModelAsync" Lane="@Lanes.FirstOrDefault(l => l.Name == _lane)" Workspace="@App.Workspace" Disabled="@(_modelsLoading || _favoriteBusy)" CatalogEfforts="_catalogEfforts" AssistanceSummary="@_session?.Assistance.Summary" OnOpening="LoadModelFavoritesAsync">
                        <ChildContent>
                        <label class="sess-lane-label" for="session-lane">Provider</label>
                        <select id="session-lane" class="sess-lane-select" aria-label="Provider for next message" value="@_lane" @onchange="OnLaneChanged">
                            @foreach (var lane in CodingLaneSelections.ForPicker(Lanes, _lane))
                            {
                                <option value="@lane.Name" selected="@(lane.Name == _lane)">@lane.SelectionLabel</option>
                            }
                        </select>
                        <ModelPicker OpenAbove="true" @key="_lane" Value="@_model" ValueChanged="SaveModelAsync" Models="ModelChoices" Disabled="_modelsLoading" />
                        <button type="button" class="sess-btn" disabled="@_modelsLoading" @onclick="RefreshModelsAsync" aria-label="Refresh models">Refresh models</button>
                        @if (_session?.Selection?.UserSelected == true)
                        {
                            <span class="sess-muted" title="Messages start with your choice. If it refuses, handoff follows your settings. Use /auto to let Talavine Code choose the starting model.">Starts with your choice</span>
                        }
                        @if (_modelSource is not null) { <span class="sess-muted">@_modelSource</span> }
                        @if (_modelsLoading) { <span class="sess-muted" role="status">Loading models…</span> }
                        @if (_modelError is not null) { <span class="sess-muted" title="@_modelError">Model list unavailable; custom IDs still work.</span> }
                        <button type="button" class="sess-btn @(_runner.PlanMode ? "sess-btn--active" : "")" aria-pressed="@(_runner.PlanMode ? "true" : "false")"
                                title="Investigate read-only and propose a plan before changing anything" @onclick="TogglePlanMode">Plan first</button>
                        @if (_runner.IsRunning || _runner.HasUnfinishedGoal)
                        {
                            <select class="sess-lane-select" aria-label="Follow-up delivery" @bind="_sendMode">
                                <option value="queue">@(_runner.HasUnfinishedGoal ? "Send to agent inbox" : "Queue after current work")</option>
                                <option value="steer">Interrupt and steer now</option>
                            </select>
                        }
                        @if (UsesGoalInbox)
                        {
                            <select class="sess-lane-select" aria-label="Goal message kind" @bind="_goalMessageKind">
                                @foreach (var kind in Enum.GetValues<SwarmCore.Agent.Communication.GoalMessageKind>()) { <option value="@kind">@kind</option> }
                            </select>
                        }
                        </ChildContent>
                        <FavoriteControls>
                            <ChatModelFavorites Current="CurrentModelFavorite" Favorites="_modelFavorites" OnChange="ChangeModelFavoriteAsync" OnSelect="SelectModelFavoriteAsync" IsAvailable="FavoriteAvailable" Disabled="@(_modelsLoading || _favoriteBusy)" Error="@_favoriteError" />
                        </FavoriteControls>
                        <AssistanceControls>
                            <ChatAssistanceControl @key="SessionId" Revision="@(_session?.AssistanceRevision ?? 0)" OnEditing="BeginAssistanceEdit" Value="@(_session?.Assistance ?? new())" ValueChanged="SaveAssistanceAsync" Choices="AssistanceChoices" OnOpening="LoadAssistanceChoicesAsync" Disabled="_runner.IsRunning" />
                        </AssistanceControls>
                        </ComposerModelPicker>
                        <SwarmCore.Chat.Components.DictateButton TargetSelector=".chat-composer__input" Class="sess-dictate" />
                    </Toolbar>
                </ChatComposer>
                </AttachmentIntake>
            </div>
        </div>

        <ModelCompareDialog @ref="_compare" Lanes="Lanes" OnStart="RunComparisonAsync" />

        @if (_showChanges)
        {
            <ChangesPanel Source="ChangesSource" RefreshToken="_refreshToken" Class="sess-changes" ButtonClass="sess-btn"
                          OnClose="ToggleChanges" OnCountChanged="OnChangeCount">
                <FileActions Context="file">
                    <button type="button" class="sess-btn" @onclick="() => OpenArtifact(file.Path)">Open file in artifacts</button>
                    <OpenInEditorButton Targets="@(new[] { new SwarmCore.Coding.Ide.EditorTarget(file.Path) })" RepositoryRoot="@_session.RepositoryRoot" />
                </FileActions>
            </ChangesPanel>
        }
        @if (_showArtifacts)
        {
            <ArtifactPanel @key="_session.RepositoryRoot" RepositoryRoot="@_session.RepositoryRoot" FilePath="@_artifactPath" OnClose="ToggleArtifacts" />
        }
    </div>
}

@code {
    private static string JobStateLabel(string state) => state switch
    {
        "Completed" => "Answer ready",
        "Interrupted" => "Interrupted — inspect saved work before continuing",
        "Incomplete" => "Work incomplete",
        "Failed" => "Needs attention",
        _ => state,
    };
    private static string AcceptanceLabel(CodingAcceptanceStatus status) => status switch
    {
        CodingAcceptanceStatus.Passed => "· Acceptance checks passed",
        CodingAcceptanceStatus.Failed => "· Acceptance checks failed",
        _ => "· Completion unverified",
    };
    private RenderFragment RenderEntry(SwarmCode.Hosting.TranscriptEntry entry) => __builder =>
    {
        switch (entry)
        {
            case UserEntry user when user.IsContinuation:
                var lines = user.Text.Split('\n');
                var expanded = _expanded.Contains(user.Id);
                var shown = expanded || lines.Length <= 1 ? user.Text : lines[0].Trim();
                <ChatMessageBubble @key="user.Id" Role="user" Markdown="@shown" IsContinuation="true" Meta="@UserMeta(user)" title="@AppNavigation.FullTime(user.AtUtc)">
                    @if (lines.Length > 1)
                    {
                        <button type="button" class="sess-more" @onclick="() => ToggleExpanded(user.Id)">@(expanded ? "show less" : "show more")</button>
                    }
                </ChatMessageBubble>
                break;
            case UserEntry user:
                <ChatMessageBubble @key="user.Id" Role="user" Markdown="@user.Text" Meta="@UserMeta(user)" title="@AppNavigation.FullTime(user.AtUtc)">
                    @foreach (var file in user.Attachments)
                    {
                        <button type="button" class="sess-file-link" @onclick="() => OpenArtifact(file.LocalPath)">@file.FileName</button>
                    }
                </ChatMessageBubble>
                break;
            case AssistantEntry assistant:
                var reasoning = assistant.Reasoning;
                if (App.Preferences.Current.ShowReasoning && reasoning.Length > 0)
                {
                    <ReasoningBlock @key="@(assistant.Id + "-r")" Text="@reasoning" IsActive="@(assistant.IsStreaming && assistant.Text.Length == 0)" InitiallyExpanded="false" />
                }
                if (assistant.Text.Length > 0 || assistant.IsStreaming)
                {
                    <ChatMessageBubble @key="assistant.Id" Role="assistant" Markdown="@assistant.Text" IsStreaming="assistant.IsStreaming" Meta="@AssistantMeta(assistant)" title="@AppNavigation.FullTime(assistant.AtUtc)" />
                }
                break;
            case ToolCallEntry tool:
                <div class="sess-tool-entry" @key="tool.Id">
                <ToolCallCard @key="tool.Id"
                              ToolName="@tool.ToolName"
                              InputJson="@tool.InputJson"
                              Result="@tool.Result"
                              State="@MapState(tool.State)"
                              AutoExpandErrors="false"
                              Elapsed="tool.Elapsed"
                              ProgressStatus="@StepStatus(tool)"
                              ProgressFraction="StepFraction(tool)"
                              StartedAt="StepStarted(tool)"
                              CancelRequested="StepCancelRequested(tool)"
                              OnCancel="() => CancelStep(tool)">
                    <HeaderActions><OpenInEditorButton Targets="EditorTargets(tool)" RepositoryRoot="@_session?.RepositoryRoot" /></HeaderActions>
                </ToolCallCard>
                @foreach (var path in SwarmCore.Coding.Files.CodingFilePreviews.References(tool.InputJson))
                {
                    <button type="button" class="sess-file-link" title="@path" @onclick="() => OpenArtifact(path)">Open @System.IO.Path.GetFileName(path)</button>
                }
                </div>
                break;
            case NoticeEntry notice when notice.Id == _recoveryNoticeId:
                var presentation = ChatNoticePresentation.Create(notice.Text, notice.Details);
                <ChatNotice @key="notice.Id" Kind="recovery" Title="@RecoveryTitle(notice)" Actions="RecoveryActions(notice)">
                    @presentation.Summary
                    @if (!string.IsNullOrWhiteSpace(presentation.Details))
                    {
                        <details class="chat-notice__details">
                            <summary>Details</summary>
                            <pre>@presentation.Details</pre>
                        </details>
                    }
                </ChatNotice>
                break;
            case NoticeEntry notice:
                <ChatNotice @key="notice.Id" Kind="@NoticeKindName(notice.Kind)" Text="@notice.Text" Details="@notice.Details" />
                break;
            case TurnChangesEntry changes:
                <div class="sess-turn-changes" @key="changes.Id">
                    <span class="sess-muted">@FilesChangedLabel(changes)</span>
                    @if (changes.Undone)
                    {
                        <span class="sess-muted">· undone</span>
                    }
                    else if (_undoPrompt?.EntryId != changes.Id)
                    {
                        <button type="button" class="sess-btn" disabled="@(_runner?.IsRunning == true || _undoBusy)" title="Restore the files this turn changed" @onclick="() => PrepareUndoAsync(changes)">Undo</button>
                    }
                </div>
                @if (_undoPrompt is { } prompt && prompt.EntryId == changes.Id)
                {
                    <div class="sess-undo" role="dialog" aria-label="Undo this turn's file changes">
                        <p>@prompt.Preview.Summary</p>
                        <ul class="sess-undo__files">
                            @foreach (var file in prompt.Preview.Changes.Where(f => !prompt.Preview.AlreadyRestored.Contains(f.Path)).Take(UndoListLimit))
                            {
                                var conflict = prompt.Preview.Conflicts.Contains(file.Path);
                                <li class="@(conflict ? "sess-undo__conflict" : "")">@UndoVerb(file) @file.Path@(conflict ? " (changed since this turn)" : "")</li>
                            }
                        </ul>
                        @if (prompt.Preview.Changes.Count - prompt.Preview.AlreadyRestored.Count > UndoListLimit)
                        {
                            <p class="sess-muted">and @(prompt.Preview.Changes.Count - prompt.Preview.AlreadyRestored.Count - UndoListLimit) more</p>
                        }
                        <div class="sess-undo__actions">
                            @if (prompt.Preview.Conflicts.Count == 0)
                            {
                                <button type="button" class="sess-btn sess-btn--primary" disabled="@_undoBusy" @onclick="() => RunUndoAsync(changes, SwarmCore.Coding.Checkpoints.TurnUndoConflictMode.Refuse)">Undo @Files(prompt.Preview.Changes.Count - prompt.Preview.AlreadyRestored.Count)</button>
                            }
                            else
                            {
                                <button type="button" class="sess-btn" disabled="@_undoBusy" @onclick="() => RunUndoAsync(changes, SwarmCore.Coding.Checkpoints.TurnUndoConflictMode.Skip)">Skip changed files</button>
                                <button type="button" class="sess-btn sess-btn--danger" disabled="@_undoBusy" @onclick="() => RunUndoAsync(changes, SwarmCore.Coding.Checkpoints.TurnUndoConflictMode.Force)">Undo anyway</button>
                            }
                            <button type="button" class="sess-btn" disabled="@_undoBusy" @onclick="CancelUndo">Cancel</button>
                        </div>
                    </div>
                }
                break;
            case PermissionEntry permission:
                <PermissionCard @key="permission.Id"
                                Title="@PermissionTitle(permission)"
                                Target="@PermissionTarget(permission)"
                                Permissions="permission.Permissions"
                                Decision="PermissionDecision(permission)"
                                OnDecide="decision => DecidePermission(permission, decision)"
                                CanAlwaysAllow="CanGrantForConversation(permission)"
                                AlwaysAllowLabel="@ConversationGrantLabel"
                                CanChange="CanChangePermission(permission)"
                                ChangeRequested="PermissionChangeRequested(permission)"
                                OnChange="() => ChangePermission(permission)"
                                ReceiptActions="PermissionReceiptNote(permission)" />
                break;
            case QuestionEntry question:
                <QuestionCard @key="question.Id"
                              Entry="question"
                              OnAnswer="answer => AnswerQuestion(question, answer.Text, answer.Selected)"
                              OnSkip="() => SkipQuestion(question)" />
                break;
        }
    };
}

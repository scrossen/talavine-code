        <details><summary>Advanced Chrome connection</summary><div class="sc-field"><label class="sc-field__label" for="sc-chrome-cdp">Existing Chrome connection (overrides profile choice)</label><input id="sc-chrome-cdp" class="sc-input" placeholder="http://127.0.0.1:9222" @bind="_computer.ChromeCdpEndpoint" /></div></details>
        <button type="button" class="sc-btn sc-btn--primary" disabled="@(_busy || State.AnyTurnRunning)" @onclick="SaveComputerAsync">Save computer settings</button>
        @if (State.AnyTurnRunning) { <p class="sc-muted">Stop active work before changing runtime settings.</p> }
    </section>
    </SettingsDialog>
    <SettingsDialog Id="attachments" Title="Attachments" Description="File sizes, file counts and extracted text." Filter="@_settingsSearch" Message="@_message" IsError="@_messageIsError">
    <section class="sc-card">
        <h2 class="sc-card__title">Attachments</h2>
        <p class="sc-card__copy">Zero means unlimited. These optional limits control local imports and extracted text; each provider still applies its own request and context limits.</p>
        <div class="sc-row">
            <div class="sc-field"><label class="sc-field__label" for="sc-file-limit">Per file (MB)</label><input id="sc-file-limit" class="sc-input" type="number" min="0" step="any" @bind="_attachmentFileMb" /></div>
            <div class="sc-field"><label class="sc-field__label" for="sc-total-limit">Total per message (MB)</label><input id="sc-total-limit" class="sc-input" type="number" min="0" step="any" @bind="_attachmentTotalMb" /></div>
            <div class="sc-field"><label class="sc-field__label" for="sc-count-limit">Files per message</label><input id="sc-count-limit" class="sc-input" type="number" min="0" @bind="_attachmentCount" /></div>
